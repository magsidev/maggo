    var moveToSheet = document.getElementById('moveToSheet');
    var closeSheetBtn = document.getElementById('closeSheetBtn');
    var cancelSheetBtn = document.getElementById('cancelSheetBtn');
    var confirmSheetBtn = document.getElementById('confirmSheetBtn');
