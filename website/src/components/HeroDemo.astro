---
// HeroDemo.astro
---

<div class="demo-container" id="demo">
  <!-- Interactive hint badge -->
  <div class="demo-interactive-hint">
    <span class="hint-dot"></span>
    <span class="hint-text">Live Preview: Click <strong>Tabs</strong>, <strong>Split View (⌘⇧S)</strong>, or <strong>Move To (⌘⇧M)</strong> below</span>
  </div>

  <!-- macOS Window Frame -->
  <div class="mac-window" id="macWindow">
    <!-- Window Titlebar & Tabs -->
    <div class="mac-titlebar">
      <!-- Traffic Lights -->
      <div class="traffic-lights">
        <span class="light close"></span>
        <span class="light minimize"></span>
        <span class="light maximize"></span>
      </div>

      <!-- Tab Bar -->
      <div class="tab-bar" role="tablist">
        <button class="mac-tab active" id="tabDownloads" data-tab="downloads" role="tab" aria-selected="true">
          <svg class="tab-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span class="tab-title">Downloads</span>
          <span class="tab-badge">5</span>
        </button>

        <button class="mac-tab" id="tabProjects" data-tab="projects" role="tab" aria-selected="false">
          <svg class="tab-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
          </svg>
          <span class="tab-title">Projects</span>
          <span class="tab-badge">4</span>
        </button>

        <button class="mac-tab" id="tabDocuments" data-tab="documents" role="tab" aria-selected="false">
          <svg class="tab-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
          </svg>
          <span class="tab-title">Documents</span>
        </button>

        <button class="new-tab-btn" title="New Tab (⌘T)" id="newTabBtn">+</button>
      </div>

      <div class="window-title-spacer"></div>
    </div>

    <!-- App Toolbar -->
    <div class="mac-toolbar">
      <div class="toolbar-group">
        <button class="tool-btn active-tool" id="btnToggleSplit" title="Toggle Split View (⌘⇧S)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="3"/>
            <line x1="12" y1="3" x2="12" y2="21"/>
          </svg>
          <span>Split View</span>
          <span class="kbd-key-sm">⌘⇧S</span>
        </button>

        <div class="toolbar-divider"></div>

        <button class="tool-btn" id="btnMoveTo" title="Move To… (⌘⇧M)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="12" y1="18" x2="12" y2="12"/>
            <line x1="9" y1="15" x2="15" y2="15"/>
          </svg>
          <span>Move To…</span>
          <span class="kbd-key-sm">⌘⇧M</span>
        </button>

        <button class="tool-btn" id="btnCopyTo" title="Copy To… (⌘⇧C)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
          <span>Copy To…</span>
          <span class="kbd-key-sm">⌘⇧C</span>
        </button>

        <button class="tool-btn tool-icon-only" title="New Folder (⌘⇧N)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
            <line x1="12" y1="11" x2="12" y2="17"/>
            <line x1="9" y1="14" x2="15" y2="14"/>
          </svg>
        </button>
      </div>

      <!-- Quick Search Bar -->
      <div class="toolbar-search">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" id="demoSearchInput" placeholder="Search current folder…" readonly value="" />
      </div>
    </div>

    <!-- Interactive Breadcrumb Bar -->
    <div class="mac-breadcrumb-bar">
      <div class="breadcrumb-container" id="breadcrumbTrail">
        <span class="crumb-segment">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="8" rx="2"/>
            <rect x="2" y="14" width="20" height="8" rx="2"/>
            <line x1="6" y1="6" x2="6.01" y2="6"/>
            <line x1="6" y1="18" x2="6.01" y2="18"/>
          </svg>
          Macintosh HD
        </span>
        <span class="crumb-separator">&rsaquo;</span>
        <span class="crumb-segment">Users</span>
        <span class="crumb-separator">&rsaquo;</span>
        <span class="crumb-segment">alex</span>
        <span class="crumb-separator">&rsaquo;</span>
        <span class="crumb-segment active-crumb" id="activeCrumbText">Downloads</span>
      </div>
      <div class="view-mode-toggle">
        <span class="view-icon active">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="8" y1="6" x2="21" y2="6"/>
            <line x1="8" y1="12" x2="21" y2="12"/>
            <line x1="8" y1="18" x2="21" y2="18"/>
            <line x1="3" y1="6" x2="3.01" y2="6"/>
            <line x1="3" y1="12" x2="3.01" y2="12"/>
            <line x1="3" y1="18" x2="3.01" y2="18"/>
          </svg>
        </span>
        <span class="view-icon">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"/>
            <rect x="14" y="3" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/>
            <rect x="3" y="14" width="7" height="7"/>
          </svg>
        </span>
      </div>
    </div>

    <!-- App Body: Sidebar + Panes -->
    <div class="mac-app-body">
      <!-- Left Sidebar -->
      <aside class="mac-sidebar">
        <!-- Home -->
        <div class="sidebar-section">
          <div class="sidebar-item">
            <svg class="sidebar-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#0A84FF" stroke-width="2">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            <span>Home</span>
          </div>
        </div>

        <!-- Favorites -->
        <div class="sidebar-section">
          <div class="sidebar-header">Favorites</div>
          <div class="sidebar-item active" id="sideDownloads">
            <svg class="sidebar-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="8 12 12 16 16 12"/>
              <line x1="12" y1="8" x2="12" y2="16"/>
            </svg>
            <span>Downloads</span>
          </div>
          <div class="sidebar-item" id="sideDocuments">
            <svg class="sidebar-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            <span>Documents</span>
          </div>
          <div class="sidebar-item">
            <svg class="sidebar-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
            <span>Desktop</span>
          </div>
          <div class="sidebar-item" id="sideProjects">
            <svg class="sidebar-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
            </svg>
            <span>Projects</span>
          </div>
        </div>

        <!-- This Mac / Storage -->
        <div class="sidebar-section">
          <div class="sidebar-header">This Mac</div>
          <div class="sidebar-drive-item">
            <div class="drive-icon-wrap internal">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zm14 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
              </svg>
            </div>
            <div class="drive-info">
              <span class="drive-name">Macintosh HD</span>
              <span class="drive-capacity">494 GB total • 312 GB free</span>
            </div>
          </div>
          <div class="sidebar-drive-item">
            <div class="drive-icon-wrap external">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M6 2h12a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm6 14a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/>
              </svg>
            </div>
            <div class="drive-info">
              <span class="drive-name">External SSD</span>
              <span class="drive-capacity">1.8 TB total • 940 GB free</span>
            </div>
          </div>
        </div>
      </aside>

      <!-- Main Work Panes Area -->
      <div class="panes-wrapper split-active" id="panesWrapper">
        <!-- Left Pane: Source (Downloads) -->
        <div class="file-pane" id="leftPane">
          <div class="pane-header">
            <div class="pane-title-badge">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              <span id="leftPaneTitle">Downloads</span>
            </div>
            <span class="pane-meta">5 items</span>
          </div>

          <div class="file-table">
            <div class="table-header">
              <span class="col-name">Name</span>
              <span class="col-date">Date Modified</span>
              <span class="col-size">Size</span>
              <span class="col-kind">Kind</span>
            </div>

            <!-- File Item 1 -->
            <div class="table-row file-selected" id="fileRow1">
              <div class="col-name">
                <div class="file-icon-badge pdf">PDF</div>
                <span class="file-label">invoice_client_march.pdf</span>
              </div>
              <span class="col-date">Today, 2:15 PM</span>
              <span class="col-size">248 KB</span>
              <span class="col-kind">PDF Document</span>
            </div>

            <!-- File Item 2 -->
            <div class="table-row">
              <div class="col-name">
                <div class="file-icon-badge pdf">PDF</div>
                <span class="file-label">presentation_v2.pdf</span>
              </div>
              <span class="col-date">Yesterday</span>
              <span class="col-size">12.4 MB</span>
              <span class="col-kind">PDF Document</span>
            </div>

            <!-- File Item 3 -->
            <div class="table-row">
              <div class="col-name">
                <div class="file-icon-badge folder">DIR</div>
                <span class="file-label">photos_shoot/</span>
              </div>
              <span class="col-date">Aug 28, 2026</span>
              <span class="col-size">42 items</span>
              <span class="col-kind">Folder</span>
            </div>

            <!-- File Item 4 -->
            <div class="table-row">
              <div class="col-name">
                <div class="file-icon-badge zip">ZIP</div>
                <span class="file-label">brand_assets.zip</span>
              </div>
              <span class="col-date">Aug 25, 2026</span>
              <span class="col-size">84.2 MB</span>
              <span class="col-kind">Zip Archive</span>
            </div>

            <!-- File Item 5 -->
            <div class="table-row">
              <div class="col-name">
                <div class="file-icon-badge sh">SH</div>
                <span class="file-label">install.sh</span>
              </div>
              <span class="col-date">Aug 20, 2026</span>
              <span class="col-size">1.2 KB</span>
              <span class="col-kind">Shell Script</span>
            </div>
          </div>

          <div class="drag-hint">
            <span class="drag-arrow">&rarr;</span> Drag and drop to right pane or use <strong>Move To (⌘⇧M)</strong>
          </div>
        </div>

        <!-- Split Pane Divider -->
        <div class="split-divider" id="splitDivider" title="Drag to resize panes">
          <div class="divider-handle"></div>
        </div>

        <!-- Right Pane: Destination (Projects / Finance) -->
        <div class="file-pane" id="rightPane">
          <div class="pane-header">
            <div class="pane-title-badge destination">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
              </svg>
              <span>Projects / 2026</span>
            </div>
            <span class="pane-meta">4 items</span>
          </div>

          <div class="file-table">
            <div class="table-header">
              <span class="col-name">Name</span>
              <span class="col-date">Date Modified</span>
              <span class="col-size">Size</span>
              <span class="col-kind">Kind</span>
            </div>

            <div class="table-row target-highlight">
              <div class="col-name">
                <div class="file-icon-badge folder target">DIR</div>
                <span class="file-label">Finance & Invoices/</span>
              </div>
              <span class="col-date">Today, 11:30 AM</span>
              <span class="col-size">18 items</span>
              <span class="col-kind">Folder</span>
            </div>

            <div class="table-row">
              <div class="col-name">
                <div class="file-icon-badge folder">DIR</div>
                <span class="file-label">Client_Contracts/</span>
              </div>
              <span class="col-date">Aug 30, 2026</span>
              <span class="col-size">7 items</span>
              <span class="col-kind">Folder</span>
            </div>

            <div class="table-row">
              <div class="col-name">
                <div class="file-icon-badge folder">DIR</div>
                <span class="file-label">Assets/</span>
              </div>
              <span class="col-date">Aug 22, 2026</span>
              <span class="col-size">89 items</span>
              <span class="col-kind">Folder</span>
            </div>

            <div class="table-row">
              <div class="col-name">
                <div class="file-icon-badge xls">XLS</div>
                <span class="file-label">annual_budget_2026.xlsx</span>
              </div>
              <span class="col-date">Aug 18, 2026</span>
              <span class="col-size">1.8 MB</span>
              <span class="col-kind">Excel Sheet</span>
            </div>
          </div>

          <div class="destination-dropzone">
            <span>Drop files here to move directly</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Simulated Move To Sheet Dialog (Toggled on button click) -->
    <div class="move-to-modal-overlay" id="moveToModal" style="display: none;">
      <div class="mac-sheet-modal">
        <div class="sheet-header">
          <div class="sheet-title-group">
            <span class="sheet-title">Move 1 file to…</span>
            <span class="sheet-subtitle">Select or fuzzy search a destination folder</span>
          </div>
          <button class="sheet-close-btn" id="closeMoveTo">&times;</button>
        </div>

        <div class="sheet-search">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input type="text" value="Finance" readonly />
        </div>

        <div class="sheet-destinations">
          <div class="sheet-dest-item selected">
            <div class="dest-icon">📁</div>
            <div class="dest-info">
              <span class="dest-name">Finance & Invoices</span>
              <span class="dest-path">~/Projects/2026/Finance & Invoices</span>
            </div>
            <span class="kbd-key-sm">↵ Enter</span>
          </div>
          <div class="sheet-dest-item">
            <div class="dest-icon">📁</div>
            <div class="dest-info">
              <span class="dest-name">Client_Contracts</span>
              <span class="dest-path">~/Projects/2026/Client_Contracts</span>
            </div>
          </div>
          <div class="sheet-dest-item">
            <div class="dest-icon">💾</div>
            <div class="dest-info">
              <span class="dest-name">External SSD / Backup</span>
              <span class="dest-path">/Volumes/External SSD/Backup</span>
            </div>
          </div>
        </div>

        <div class="sheet-actions">
          <button class="btn btn-secondary sheet-btn" id="cancelMoveTo">Cancel</button>
          <button class="btn btn-primary sheet-btn" id="confirmMoveTo">Move File</button>
        </div>
      </div>
    </div>

    <!-- Window Status Footer -->
    <div class="mac-status-bar">
      <div class="status-left">
        <span class="status-indicator"></span>
        <span id="statusText">5 items • 98.2 MB selected • Swift 6 Native Engine</span>
      </div>
      <div class="status-right">
        <span>Macintosh HD: 312 GB free</span>
      </div>
    </div>
  </div>
</div>

<style>
  .demo-container {
    margin-top: 2.5rem;
    margin-bottom: 2rem;
    position: relative;
  }

  .demo-interactive-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    box-shadow: var(--shadow-sm);
  }

  .hint-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-accent);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  /* macOS Window Frame */
  .mac-window {
    background: #FFFFFF;
    border-radius: 12px;
    box-shadow: var(--shadow-mac-window);
    border: 1px solid rgba(0, 0, 0, 0.12);
    overflow: hidden;
    position: relative;
    text-align: left;
  }

  /* Titlebar */
  .mac-titlebar {
    background: #EDEFEF;
    border-bottom: 1px solid #D5D7D7;
    height: 38px;
    display: flex;
    align-items: center;
    padding: 0 12px;
    gap: 12px;
    user-select: none;
  }

  .traffic-lights {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .light {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }

  .light.close { background: #FF5F56; border: 1px solid #E0443E; }
  .light.minimize { background: #FFBD2E; border: 1px solid #DEA123; }
  .light.maximize { background: #27C93F; border: 1px solid #1AAB29; }

  .tab-bar {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    overflow-x: auto;
  }

  .mac-tab {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-body);
    transition: all 0.15s ease;
  }

  .mac-tab:hover {
    background: rgba(0, 0, 0, 0.08);
  }

  .mac-tab.active {
    background: #FFFFFF;
    color: var(--color-text-main);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
    border-color: rgba(0, 0, 0, 0.08);
  }

  .tab-badge {
    background: rgba(0, 0, 0, 0.08);
    font-size: 0.6875rem;
    padding: 1px 5px;
    border-radius: 10px;
  }

  .new-tab-btn {
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-text-muted);
    padding: 2px 8px;
    border-radius: 5px;
  }

  .new-tab-btn:hover {
    background: rgba(0, 0, 0, 0.08);
    color: var(--color-text-main);
  }

  .window-title-spacer {
    width: 60px;
  }

  /* Toolbar */
  .mac-toolbar {
    background: #F6F8FA;
    border-bottom: 1px solid #E2E8F0;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    gap: 8px;
  }

  .toolbar-group {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .tool-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 4px 9px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-body);
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.04);
    transition: all 0.15s ease;
  }

  .tool-btn:hover {
    background: #F1F5F9;
    border-color: #94A3B8;
  }

  .tool-btn.active-tool {
    background: #EBF5FF;
    border-color: #93C5FD;
    color: #0066D6;
  }

