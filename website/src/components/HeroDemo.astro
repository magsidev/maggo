    };

    // Elements
    var panesWrapper = document.getElementById('panesWrapper');
    var btnToggleSplit = document.getElementById('btnToggleSplit');
    var leftPane = document.getElementById('leftPane');
    var rightPane = document.getElementById('rightPane');
    var leftTableBody = document.getElementById('leftTableBody');
    var rightTableBody = document.getElementById('rightTableBody');
    var leftIconGrid = document.getElementById('leftIconGrid');
    var rightIconGrid = document.getElementById('rightIconGrid');
    var leftFileTable = document.getElementById('leftFileTable');
    var rightFileTable = document.getElementById('rightFileTable');
    var leftBreadcrumbBar = document.getElementById('leftBreadcrumbBar');
    var rightBreadcrumbBar = document.getElementById('rightBreadcrumbBar');
    var tabItemsScroll = document.getElementById('tabItemsScroll');
    var statusMsg = document.getElementById('statusMsg');
    var selectionSummary = document.getElementById('selectionSummary');
    var btnUndo = document.getElementById('btnUndo');
