    // Authentic SVG File Icons (Scaled properly for table and grid)
    function getFileSvg(type, size) {
      var s = size || 16;
      if (type === 'pdf') {
        return '<svg width="' + s + '" height="' + s + '" viewBox="0 0 24 24" fill="#DC2626"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>';
      } else if (type === 'folder') {
        return '<svg width="' + s + '" height="' + s + '" viewBox="0 0 24 24" fill="#0A84FF"><path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>';
      } else if (type === 'zip') {
        return '<svg width="' + s + '" height="' + s + '" viewBox="0 0 24 24" fill="#D97706"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2zm-6 10h-4v-2h4v2zm0-4h-4v-2h4v2z"/></svg>';
      } else if (type === 'sh') {
        return '<svg width="' + s + '" height="' + s + '" viewBox="0 0 24 24" fill="#475569"><path d="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/></svg>';
      } else if (type === 'xls') {
        return '<svg width="' + s + '" height="' + s + '" viewBox="0 0 24 24" fill="#16A34A"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14H8v-2h4v2zm0-4H8v-2h4v2zm0-4H8V7h4v2zm5 8h-4v-2h4v2zm0-4h-4v-2h4v2zm0-4h-4V7h4v2z"/></svg>';
      } else if (type === 'img') {
        return '<svg width="' + s + '" height="' + s + '" viewBox="0 0 24 24" fill="#8B5CF6"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>';
      }
      return '<svg width="' + s + '" height="' + s + '" viewBox="0 0 24 24" fill="#2563EB"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>';
    }

    // Render Breadcrumbs
    function renderBreadcrumbs(container, folderName) {
      if (!container) return;
      var data = fileData[folderName] || { breadcrumbs: [folderName] };
      var html = '';
      data.breadcrumbs.forEach(function (segment, index) {
        var isLast = index === data.breadcrumbs.length - 1;
        if (index === 0 && segment === 'Macintosh HD') {
          html += '<span class="bc-segment' + (isLast ? ' active' : '') + '" data-nav="' + segment + '"><svg width="12" height="12" viewBox="0 0 24 24" fill="#0A84FF"><path d="M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zm14 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/></svg>' + segment + '</span>';
        } else {
          html += '<span class="bc-segment' + (isLast ? ' active' : '') + '" data-nav="' + segment + '">' + segment + '</span>';
        }
        if (!isLast) {
          html += '<span class="bc-sep">›</span>';
        }
      });
      container.innerHTML = html;

      // Clickable breadcrumbs
      var segments = container.querySelectorAll('.bc-segment');
      segments.forEach(function (el) {
        el.addEventListener('click', function () {
          var target = el.getAttribute('data-nav');
          if (target && fileData[target]) {
            navigateTo(target);
          }
        });
      });
    }

    // Render Table and Grid
    function renderPane(side) {
      var folderName = side === 'left' ? state.leftFolder : state.rightFolder;
      var tableBody = side === 'left' ? leftTableBody : rightTableBody;
      var iconGrid = side === 'left' ? leftIconGrid : rightIconGrid;
      var fileTable = side === 'left' ? leftFileTable : rightFileTable;
      var breadcrumbs = side === 'left' ? leftBreadcrumbBar : rightBreadcrumbBar;
      var viewMode = side === 'left' ? state.leftViewMode : state.rightViewMode;
      var selectedId = side === 'left' ? state.leftSelectedId : state.rightSelectedId;

      renderBreadcrumbs(breadcrumbs, folderName);

      var data = fileData[folderName] || { items: [] };
      var items = data.items;

      if (state.searchQuery && side === state.activePane) {
        var query = state.searchQuery.toLowerCase();
        items = items.filter(function (item) {
          return item.name.toLowerCase().indexOf(query) !== -1;
        });
      }

      // Render Table Rows
      if (tableBody) {
        if (items.length === 0) {
          tableBody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding: 24px; color: #94A3B8;">Folder is empty or no matches</td></tr>';
        } else {
          var html = '';
          items.forEach(function (item) {
            var isSelected = item.id === selectedId;
            html += '<tr class="table-row' + (isSelected ? ' row-selected' : '') + '" data-item-id="' + item.id + '" data-is-folder="' + item.isFolder + '" data-name="' + item.name + '">';
            html += '<td class="col-td col-td-name"><div class="col-name-cell"><div class="file-icon-wrap">' + getFileSvg(item.icon, 16) + '</div><span class="file-name-text">' + item.name + (item.isFolder ? '/' : '') + '</span></div></td>';
            html += '<td class="col-td col-td-date">' + item.date + '</td>';
            html += '<td class="col-td col-td-size">' + item.size + '</td>';
            html += '<td class="col-td col-td-kind">' + item.kind + '</td>';
            html += '</tr>';
          });
          tableBody.innerHTML = html;

          var rows = tableBody.querySelectorAll('.table-row');
          rows.forEach(function (row) {
            row.addEventListener('click', function () {
              var itemId = row.getAttribute('data-item-id');
              if (side === 'left') state.leftSelectedId = itemId;
              else state.rightSelectedId = itemId;
              state.activePane = side;
              updatePaneFocus();
              renderPane(side);
              updateFooter();
            });

            row.addEventListener('dblclick', function () {
              var isFolder = row.getAttribute('data-is-folder') === 'true';
              var name = row.getAttribute('data-name');
              if (isFolder && name && fileData[name]) {
                navigateTo(name);
              }
            });
          });
        }
      }

      // Render Grid Items
      if (iconGrid) {
        if (items.length === 0) {
          iconGrid.innerHTML = '<div style="grid-column: 1/-1; text-align:center; padding: 20px; color: #94A3B8;">Empty</div>';
        } else {
          var gHtml = '';
          items.forEach(function (item) {
            var isSelected = item.id === selectedId;
            gHtml += '<div class="grid-item' + (isSelected ? ' selected' : '') + '" data-item-id="' + item.id + '" data-name="' + item.name + '" data-is-folder="' + item.isFolder + '">';
            gHtml += '<div class="grid-icon-wrap">' + getFileSvg(item.icon, 32) + '</div>';
            gHtml += '<span class="grid-label">' + item.name + '</span>';
            gHtml += '</div>';
          });
          iconGrid.innerHTML = gHtml;

          var gItems = iconGrid.querySelectorAll('.grid-item');
          gItems.forEach(function (gItem) {
            gItem.addEventListener('click', function () {
              var itemId = gItem.getAttribute('data-item-id');
              if (side === 'left') state.leftSelectedId = itemId;
              else state.rightSelectedId = itemId;
              state.activePane = side;
              updatePaneFocus();
              renderPane(side);
              updateFooter();
            });

            gItem.addEventListener('dblclick', function () {
              var isFolder = gItem.getAttribute('data-is-folder') === 'true';
              var name = gItem.getAttribute('data-name');
              if (isFolder && name && fileData[name]) {
                navigateTo(name);
              }
            });
          });
        }
      }

      // Toggle List / Grid display
      if (viewMode === 'grid') {
        if (fileTable) fileTable.style.display = 'none';
        if (iconGrid) iconGrid.style.display = 'grid';
      } else {
        if (fileTable) fileTable.style.display = 'table';
        if (iconGrid) iconGrid.style.display = 'none';
      }

      // Sync segmented view picker active state
      var paneEl = side === 'left' ? leftPane : rightPane;
      if (paneEl) {
        var vmBtns = paneEl.querySelectorAll('.vm-btn');
        vmBtns.forEach(function (b) {
          b.classList.toggle('active', b.getAttribute('data-mode') === viewMode);
        });
      }

      updateHistoryButtons(side);
    }

    // Navigate to folder
    function navigateTo(folderName) {
      if (!fileData[folderName]) return;
      var side = state.activePane;
      if (side === 'left') {
        state.leftFolder = folderName;
        state.leftHistory = state.leftHistory.slice(0, state.leftHistoryIdx + 1);
        state.leftHistory.push(folderName);
        state.leftHistoryIdx = state.leftHistory.length - 1;
        state.leftSelectedId = fileData[folderName].items[0] ? fileData[folderName].items[0].id : null;
      } else {
        state.rightFolder = folderName;
        state.rightHistory = state.rightHistory.slice(0, state.rightHistoryIdx + 1);
        state.rightHistory.push(folderName);
        state.rightHistoryIdx = state.rightHistory.length - 1;
        state.rightSelectedId = fileData[folderName].items[0] ? fileData[folderName].items[0].id : null;
      }

      updateSidebarActive(folderName);
      renderPane(side);
      updateFooter();
    }

    // Update History arrows
    function updateHistoryButtons(side) {
      var history = side === 'left' ? state.leftHistory : state.rightHistory;
      var idx = side === 'left' ? state.leftHistoryIdx : state.rightHistoryIdx;
      var backBtn = document.getElementById(side === 'left' ? 'btnLeftBack' : 'btnRightBack');
      var fwdBtn = document.getElementById(side === 'left' ? 'btnLeftForward' : 'btnRightForward');

      if (backBtn) {
        if (idx > 0) backBtn.classList.remove('disabled');
        else backBtn.classList.add('disabled');
      }
      if (fwdBtn) {
        if (idx < history.length - 1) fwdBtn.classList.remove('disabled');
        else fwdBtn.classList.add('disabled');
      }
    }

    // Update Sidebar highlight
    function updateSidebarActive(folderName) {
      if (!appSidebar) return;
      var rows = appSidebar.querySelectorAll('.sb-row, .sb-volume-item');
      rows.forEach(function (r) {
        r.classList.remove('active');
        if (r.getAttribute('data-folder') === folderName) {
          r.classList.add('active');
        }
      });
    }

    // Update Pane focus
    function updatePaneFocus() {
      if (leftPane && rightPane) {
        leftPane.classList.toggle('pane-focused', state.activePane === 'left');
        rightPane.classList.toggle('pane-focused', state.activePane === 'right');
      }
    }

    // Update Status Footer
    function updateFooter() {
      var folderName = state.activePane === 'left' ? state.leftFolder : state.rightFolder;
      var selectedId = state.activePane === 'left' ? state.leftSelectedId : state.rightSelectedId;
      var data = fileData[folderName] || { items: [] };
      var selectedItem = data.items.find(function (i) { return i.id === selectedId; });

      if (selectionSummary) {
        if (selectedItem) {
          selectionSummary.textContent = '1 selected (' + selectedItem.size + ')';
        } else {
          selectionSummary.textContent = data.items.length + ' items';
        }
      }

      if (sheetSelectedFileName && selectedItem) {
        sheetSelectedFileName.textContent = selectedItem.name;
      }
    }

    // Render Tabs
    function renderTabs() {
      if (!tabItemsScroll) return;
      var html = '';
      state.tabs.forEach(function (tab) {
        var isActive = tab.id === state.activeTabId;
        html += '<button class="tab-chip' + (isActive ? ' active' : '') + '" data-tab-id="' + tab.id + '" data-folder="' + tab.name + '">';
        html += '<svg class="tab-chip-icon" width="13" height="13" viewBox="0 0 24 24" fill="#0A84FF"><path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>';
        html += '<span class="tab-chip-title">' + tab.name + '</span>';
        if (state.tabs.length > 1) {
          html += '<span class="tab-close-icon" data-close-id="' + tab.id + '" title="Close tab">&times;</span>';
        }
        html += '</button>';
      });
      html += '<button class="tab-add-btn" id="btnAddTab" title="New Tab (⌘T)">+</button>';
      tabItemsScroll.innerHTML = html;

      var chips = tabItemsScroll.querySelectorAll('.tab-chip');
      chips.forEach(function (chip) {
        chip.addEventListener('click', function (e) {
          var closeBtn = e.target.closest('.tab-close-icon');
          if (closeBtn) {
            var closeId = closeBtn.getAttribute('data-close-id');
            closeTab(closeId);
            return;
          }
          var tabId = chip.getAttribute('data-tab-id');
          var folder = chip.getAttribute('data-folder');
          if (tabId && folder) {
            state.activeTabId = tabId;
            navigateTo(folder);
            renderTabs();
          }
        });
      });

      var addBtn = document.getElementById('btnAddTab');
      if (addBtn) addBtn.addEventListener('click', createNewTab);
    }

    function createNewTab() {
      var names = ['Documents', 'Desktop', 'Projects', 'Downloads'];
      var nextName = names[state.tabs.length % names.length];
      var newTabId = 't_' + Date.now();
      state.tabs.push({ id: newTabId, name: nextName });
      state.activeTabId = newTabId;
      navigateTo(nextName);
      renderTabs();
      if (statusMsg) statusMsg.textContent = 'Opened tab: ' + nextName;
    }

    function closeTab(tabId) {
      if (state.tabs.length <= 1) return;
      state.tabs = state.tabs.filter(function (t) { return t.id !== tabId; });
      var lastTab = state.tabs[state.tabs.length - 1];
      state.activeTabId = lastTab.id;
      navigateTo(lastTab.name);
      renderTabs();
    }

    // Toggle Split View
    if (btnToggleSplit && panesWrapper) {
      btnToggleSplit.addEventListener('click', function () {
        state.isSplit = !state.isSplit;
        if (state.isSplit) {
          panesWrapper.classList.remove('single-active');
          panesWrapper.classList.add('split-active');
          btnToggleSplit.classList.add('tb-btn-active');
          renderPane('right');
          if (statusMsg) statusMsg.textContent = 'Dual split view enabled (⌘⇧S)';
        } else {
          panesWrapper.classList.remove('split-active');
          panesWrapper.classList.add('single-active');
          btnToggleSplit.classList.remove('tb-btn-active');
          state.activePane = 'left';
          updatePaneFocus();
          if (statusMsg) statusMsg.textContent = 'Single pane view';
        }
      });
    }

    // Sidebar navigation
    if (appSidebar) {
      var sbButtons = appSidebar.querySelectorAll('.sb-row, .sb-volume-item');
      sbButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var folder = btn.getAttribute('data-folder');
          if (folder && fileData[folder]) {
            navigateTo(folder);
          }
        });
      });
    }

    // Toggle Sidebar
    if (btnToggleSidebar && appSidebar) {
      btnToggleSidebar.addEventListener('click', function () {
        var isCollapsed = appSidebar.classList.contains('collapsed');
        appSidebar.classList.toggle('collapsed');
        var tlLeft = document.getElementById('titlebarLeft');
        if (tlLeft) tlLeft.classList.toggle('collapsed');
        if (statusMsg) statusMsg.textContent = isCollapsed ? 'Sidebar expanded' : 'Sidebar collapsed';
      });
    }

    // Navigation buttons (Back, Forward, Up)
    ['left', 'right'].forEach(function (side) {
      var backBtn = document.getElementById(side === 'left' ? 'btnLeftBack' : 'btnRightBack');
      var fwdBtn = document.getElementById(side === 'left' ? 'btnLeftForward' : 'btnRightForward');
      var upBtn = document.getElementById(side === 'left' ? 'btnLeftUp' : 'btnRightUp');

      if (backBtn) {
        backBtn.addEventListener('click', function () {
          var idx = side === 'left' ? state.leftHistoryIdx : state.rightHistoryIdx;
          var history = side === 'left' ? state.leftHistory : state.rightHistory;
          if (idx > 0) {
            if (side === 'left') {
              state.leftHistoryIdx--;
              state.leftFolder = history[state.leftHistoryIdx];
            } else {
              state.rightHistoryIdx--;
              state.rightFolder = history[state.rightHistoryIdx];
            }
            renderPane(side);
            updateFooter();
          }
        });
      }

      if (fwdBtn) {
        fwdBtn.addEventListener('click', function () {
          var idx = side === 'left' ? state.leftHistoryIdx : state.rightHistoryIdx;
          var history = side === 'left' ? state.leftHistory : state.rightHistory;
          if (idx < history.length - 1) {
            if (side === 'left') {
              state.leftHistoryIdx++;
              state.leftFolder = history[state.leftHistoryIdx];
            } else {
              state.rightHistoryIdx++;
              state.rightFolder = history[state.rightHistoryIdx];
            }
            renderPane(side);
            updateFooter();
          }
        });
      }

      if (upBtn) {
        upBtn.addEventListener('click', function () {
          var folder = side === 'left' ? state.leftFolder : state.rightFolder;
          var data = fileData[folder];
          if (data && data.breadcrumbs.length > 1) {
            var parent = data.breadcrumbs[data.breadcrumbs.length - 2];
            if (fileData[parent]) {
              navigateTo(parent);
            }
          }
        });
      }
    });

    // View Mode Pickers (List / Grid)
    document.querySelectorAll('.view-mode-picker').forEach(function (picker) {
      var paneCol = picker.closest('.pane-column');
      var side = paneCol ? paneCol.getAttribute('data-side') : 'left';
      var btns = picker.querySelectorAll('.vm-btn');

      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          btns.forEach(function (x) { x.classList.remove('active'); });
          b.classList.add('active');
          var mode = b.getAttribute('data-mode') || 'list';
          if (side === 'left') state.leftViewMode = mode;
          else state.rightViewMode = mode;
          renderPane(side);
        });
      });
    });

    // Focus pane on click
    if (leftPane) leftPane.addEventListener('click', function () { state.activePane = 'left'; updatePaneFocus(); });
    if (rightPane) rightPane.addEventListener('click', function () { state.activePane = 'right'; updatePaneFocus(); });

    // Live search
    if (demoSearchInput) {
      demoSearchInput.addEventListener('input', function () {
        state.searchQuery = demoSearchInput.value.trim();
        if (btnClearSearch) {
          btnClearSearch.style.display = state.searchQuery ? 'inline' : 'none';
        }
        renderPane(state.activePane);
      });
    }

    if (btnClearSearch && demoSearchInput) {
      btnClearSearch.addEventListener('click', function () {
        demoSearchInput.value = '';
        state.searchQuery = '';
        btnClearSearch.style.display = 'none';
        renderPane(state.activePane);
      });
    }

    // Move To… / Copy To… Sheet
    var selectedDest = 'Finance & Invoices';
    if (btnMoveTo && moveToSheet) {
      btnMoveTo.addEventListener('click', function () {
        var folderName = state.activePane === 'left' ? state.leftFolder : state.rightFolder;
        var selectedId = state.activePane === 'left' ? state.leftSelectedId : state.rightSelectedId;
        var data = fileData[folderName] || { items: [] };
        var item = data.items.find(function (i) { return i.id === selectedId; });

        if (sheetModalTitle) sheetModalTitle.textContent = 'Move To…';
        if (sheetSelectedFileName) sheetSelectedFileName.textContent = item ? item.name : 'Selected item';
        if (confirmSheetBtn) confirmSheetBtn.textContent = 'Move';

        moveToSheet.style.display = 'flex';
        if (sheetSearchInput) {
          sheetSearchInput.value = '';
          sheetSearchInput.focus();
        }
      });
    }

    if (btnCopyTo && moveToSheet) {
      btnCopyTo.addEventListener('click', function () {
        var folderName = state.activePane === 'left' ? state.leftFolder : state.rightFolder;
        var selectedId = state.activePane === 'left' ? state.leftSelectedId : state.rightSelectedId;
        var data = fileData[folderName] || { items: [] };
        var item = data.items.find(function (i) { return i.id === selectedId; });

        if (sheetModalTitle) sheetModalTitle.textContent = 'Copy To…';
        if (sheetSelectedFileName) sheetSelectedFileName.textContent = item ? item.name : 'Selected item';
        if (confirmSheetBtn) confirmSheetBtn.textContent = 'Copy';

        moveToSheet.style.display = 'flex';
      });
    }

    // Sheet row selection
    var destRows = document.querySelectorAll('.sheet-row');
    destRows.forEach(function (r) {
      r.addEventListener('click', function () {
        destRows.forEach(function (x) { x.classList.remove('selected'); });
        r.classList.add('selected');
        selectedDest = r.getAttribute('data-dest') || 'Finance & Invoices';
      });
    });

    function closeSheet() {
      if (moveToSheet) moveToSheet.style.display = 'none';
    }
    if (closeSheetBtn) closeSheetBtn.addEventListener('click', closeSheet);
    if (cancelSheetBtn) cancelSheetBtn.addEventListener('click', closeSheet);

    if (confirmSheetBtn) {
      confirmSheetBtn.addEventListener('click', function () {
        closeSheet();
        var folderName = state.activePane === 'left' ? state.leftFolder : state.rightFolder;
        var selectedId = state.activePane === 'left' ? state.leftSelectedId : state.rightSelectedId;
        var data = fileData[folderName] || { items: [] };
        var itemIdx = data.items.findIndex(function (i) { return i.id === selectedId; });

        if (itemIdx !== -1) {
          var item = data.items[itemIdx];
          var isCopy = confirmSheetBtn.textContent === 'Copy';

          if (!isCopy) {
            data.items.splice(itemIdx, 1);
            if (fileData[selectedDest]) {
              fileData[selectedDest].items.unshift(item);
            }
            state.undoAction = {
              type: 'move',
              item: item,
              from: folderName,
              to: selectedDest
            };
            if (statusMsg) statusMsg.textContent = '✓ Moved ' + item.name + ' to ' + selectedDest;
          } else {
            var copyItem = Object.assign({}, item, {
              id: 'copy_' + Date.now(),
              name: 'Copy of ' + item.name
            });
            if (fileData[selectedDest]) {
              fileData[selectedDest].items.unshift(copyItem);
            }
            if (statusMsg) statusMsg.textContent = '✓ Copied ' + item.name + ' to ' + selectedDest;
          }

          if (btnUndo && undoSep) {
            btnUndo.style.display = 'inline-flex';
            undoSep.style.display = 'inline-block';
          }

          renderPane('left');
          renderPane('right');
          updateFooter();
        }
      });
    }

    // Safe Undo
    if (btnUndo) {
      btnUndo.addEventListener('click', function () {
        if (!state.undoAction) return;
        var act = state.undoAction;
        if (act.type === 'move') {
          if (fileData[act.to]) {
            fileData[act.to].items = fileData[act.to].items.filter(function (i) { return i.id !== act.item.id; });
          }
          if (fileData[act.from]) {
            fileData[act.from].items.unshift(act.item);
          }
          if (statusMsg) statusMsg.textContent = '↩ Undid move: ' + act.item.name + ' restored to ' + act.from;
        } else if (act.type === 'trash') {
          if (fileData[act.from]) {
            fileData[act.from].items.splice(act.index, 0, act.item);
          }
          if (statusMsg) statusMsg.textContent = '↩ Restored ' + act.item.name + ' from Trash';
        }
        state.undoAction = null;
        btnUndo.style.display = 'none';
        if (undoSep) undoSep.style.display = 'none';
        renderPane('left');
        renderPane('right');
        updateFooter();
      });
    }

    // New Folder Button
    if (btnNewFolder) {
      btnNewFolder.addEventListener('click', function () {
        var folderName = state.activePane === 'left' ? state.leftFolder : state.rightFolder;
        var data = fileData[folderName];
        if (data) {
          var newFolder = {
            id: 'folder_' + Date.now(),
            name: 'New Folder',
            date: 'Just now',
            size: '--',
            kind: 'Folder',
            isFolder: true,
            icon: 'folder'
          };
          data.items.unshift(newFolder);
          if (state.activePane === 'left') state.leftSelectedId = newFolder.id;
          else state.rightSelectedId = newFolder.id;
          renderPane(state.activePane);
          updateFooter();
          if (statusMsg) statusMsg.textContent = 'Created "New Folder" in ' + folderName;
        }
      });
    }

    // Trash Button
    if (btnTrash) {
      btnTrash.addEventListener('click', function () {
        var folderName = state.activePane === 'left' ? state.leftFolder : state.rightFolder;
        var selectedId = state.activePane === 'left' ? state.leftSelectedId : state.rightSelectedId;
        var data = fileData[folderName];
        if (data) {
          var idx = data.items.findIndex(function (i) { return i.id === selectedId; });
          if (idx !== -1) {
            var item = data.items.splice(idx, 1)[0];
            state.undoAction = { type: 'trash', item: item, from: folderName, index: idx };
            if (btnUndo && undoSep) {
              btnUndo.style.display = 'inline-flex';
              undoSep.style.display = 'inline-block';
            }
            renderPane(state.activePane);
            updateFooter();
            if (statusMsg) statusMsg.textContent = '🗑 Moved "' + item.name + '" to Trash (Click Undo to restore)';
          }
        }
      });
    }

    if (btnNewTab) btnNewTab.addEventListener('click', createNewTab);

    // Traffic Lights
    var btnWinClose = document.getElementById('btnWinClose');
    var btnWinMin = document.getElementById('btnWinMin');
    var btnWinMax = document.getElementById('btnWinMax');
    var macWindow = document.getElementById('macWindow');

    if (btnWinClose && macWindow) {
      btnWinClose.addEventListener('click', function () {
        macWindow.style.opacity = '0.4';
        macWindow.style.transform = 'scale(0.98)';
        setTimeout(function () {
          macWindow.style.opacity = '1';
          macWindow.style.transform = 'none';
        }, 1200);
      });
    }

    if (btnWinMin && macWindow) {
      btnWinMin.addEventListener('click', function () {
        macWindow.style.transform = 'scale(0.95) translateY(12px)';
        setTimeout(function () {
          macWindow.style.transform = 'none';
        }, 800);
      });
    }

    if (btnWinMax && macWindow) {
      btnWinMax.addEventListener('click', function () {
        var isMax = macWindow.classList.toggle('maximized');
        if (isMax) macWindow.style.maxWidth = '100%';
        else macWindow.style.maxWidth = '';
      });
    }

    // Initial render
    renderTabs();
    renderPane('left');
    renderPane('right');
    updateFooter();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMaggoLiveDemo);
  } else {
    initMaggoLiveDemo();
  }
})();
</script>
