    // State
    var state = {
      activePane: 'left',
      leftFolder: 'Downloads',
      rightFolder: 'Projects',
      leftHistory: ['Downloads'],
      leftHistoryIdx: 0,
      rightHistory: ['Projects'],
      rightHistoryIdx: 0,
