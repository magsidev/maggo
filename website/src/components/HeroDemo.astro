<script>
  // Interactive Live Preview logic for Hero Mockup
  document.addEventListener('DOMContentLoaded', () => {
    const btnToggleSplit = document.getElementById('btnToggleSplit');
    const panesWrapper = document.getElementById('panesWrapper');
    const tabDownloads = document.getElementById('tabDownloads');
    const tabProjects = document.getElementById('tabProjects');
    const tabDocuments = document.getElementById('tabDocuments');
    const activeCrumbText = document.getElementById('activeCrumbText');
    const leftPaneTitle = document.getElementById('leftPaneTitle');
    const btnMoveTo = document.getElementById('btnMoveTo');
    const moveToModal = document.getElementById('moveToModal');
    const closeMoveTo = document.getElementById('closeMoveTo');
    const cancelMoveTo = document.getElementById('cancelMoveTo');
    const confirmMoveTo = document.getElementById('confirmMoveTo');
    const sideDownloads = document.getElementById('sideDownloads');
    const sideProjects = document.getElementById('sideProjects');
    const sideDocuments = document.getElementById('sideDocuments');

    // Toggle Split View
    if (btnToggleSplit && panesWrapper) {
      btnToggleSplit.addEventListener('click', () => {
        const isSplit = panesWrapper.classList.contains('split-active');
        if (isSplit) {
          panesWrapper.classList.remove('split-active');
          panesWrapper.classList.add('single-active');
          btnToggleSplit.classList.remove('active-tool');
        } else {
          panesWrapper.classList.remove('single-active');
          panesWrapper.classList.add('split-active');
          btnToggleSplit.classList.add('active-tool');
        }
      });
    }

    // Tab switching
    const setTab = (activeTab: HTMLElement, name: string) => {
      [tabDownloads, tabProjects, tabDocuments].forEach(t => {
        t?.classList.remove('active');
        t?.setAttribute('aria-selected', 'false');
      });
      activeTab.classList.add('active');
      activeTab.setAttribute('aria-selected', 'true');
      
      if (activeCrumbText) activeCrumbText.textContent = name;
      if (leftPaneTitle) leftPaneTitle.textContent = name;

      // Update sidebar highlight
      [sideDownloads, sideProjects, sideDocuments].forEach(s => s?.classList.remove('active'));
      if (name === 'Downloads' && sideDownloads) sideDownloads.classList.add('active');
      if (name === 'Projects' && sideProjects) sideProjects.classList.add('active');
      if (name === 'Documents' && sideDocuments) sideDocuments.classList.add('active');
    };

    tabDownloads?.addEventListener('click', () => setTab(tabDownloads, 'Downloads'));
    tabProjects?.addEventListener('click', () => setTab(tabProjects, 'Projects'));
    tabDocuments?.addEventListener('click', () => setTab(tabDocuments, 'Documents'));

    sideDownloads?.addEventListener('click', () => tabDownloads && setTab(tabDownloads, 'Downloads'));
    sideProjects?.addEventListener('click', () => tabProjects && setTab(tabProjects, 'Projects'));
    sideDocuments?.addEventListener('click', () => tabDocuments && setTab(tabDocuments, 'Documents'));

    // Move To Modal demonstration
    const openModal = () => {
      if (moveToModal) moveToModal.style.display = 'flex';
    };
    const closeModal = () => {
      if (moveToModal) moveToModal.style.display = 'none';
    };

    btnMoveTo?.addEventListener('click', openModal);
    closeMoveTo?.addEventListener('click', closeModal);
    cancelMoveTo?.addEventListener('click', closeModal);
    confirmMoveTo?.addEventListener('click', () => {
      closeModal();
      const statusText = document.getElementById('statusText');
      if (statusText) {
        statusText.textContent = '✓ invoice_client_march.pdf moved to ~/Projects/2026/Finance & Invoices';
        setTimeout(() => {
          statusText.textContent = '5 items • 98.2 MB selected • Swift 6 Native Engine';
        }, 3500);
      }
    });
  });
</script>
