---
// HeroDemo.astro - Pixel-perfect, fully interactive native macOS Maggo app simulation
---

<div class="demo-container" id="demo">
  <!-- Interactive hint badge -->
  <div class="demo-interactive-hint">
    <span class="hint-dot"></span>
    <span class="hint-text"><strong>Interactive Live App:</strong> Click any file or sidebar folder, switch <strong>Tabs</strong>, toggle <strong>Split View (⌘⇧S)</strong>, or test <strong>Move To (⌘⇧M)</strong></span>
  </div>

  <!-- macOS Native Window Frame -->
  <div class="mac-window" id="macWindow">
    
    <!-- Unified Top Toolbar Bar (macOS Sequoia / Sonoma style) -->
    <div class="mac-unified-titlebar">
      <!-- Left side: Traffic Lights over Sidebar -->
      <div class="titlebar-left" id="titlebarLeft">
        <div class="traffic-lights">
          <span class="light close" id="btnWinClose" title="Close"></span>
          <span class="light minimize" id="btnWinMin" title="Minimize"></span>
          <span class="light maximize" id="btnWinMax" title="Zoom"></span>
        </div>
        <button class="sidebar-toggle-btn" id="btnToggleSidebar" title="Toggle Sidebar (⌘S)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="3"/>
            <line x1="9" y1="3" x2="9" y2="21"/>
          </svg>
        </button>
      </div>

      <!-- Right side: AppToolbar (Native Maggo AppToolbar) -->
      <div class="titlebar-detail">
        <div class="toolbar-actions">
          <!-- New Tab (⌘T) -->
          <button class="tb-btn" id="btnNewTab" title="New Tab (⌘T)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="5" x2="12" y2="19"/>
              <line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
          </button>

          <!-- Split View Toggle (⌘⇧S) -->
          <button class="tb-btn tb-btn-active" id="btnToggleSplit" title="Toggle Split View (⌘⇧S)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <line x1="12" y1="3" x2="12" y2="21"/>
            </svg>
          </button>

          <div class="tb-separator"></div>

          <!-- New Folder (⌘⇧N) -->
          <button class="tb-btn" id="btnNewFolder" title="New Folder (⌘⇧N)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
              <line x1="12" y1="11" x2="12" y2="17"/>
              <line x1="9" y1="14" x2="15" y2="14"/>
            </svg>
          </button>

          <!-- Move To… (⌘⇧M) -->
          <button class="tb-btn tb-highlight-btn" id="btnMoveTo" title="Move To… (⌘⇧M)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="12" y1="18" x2="12" y2="12"/>
              <line x1="9" y1="15" x2="15" y2="15"/>
            </svg>
            <span class="tb-btn-label">Move To…</span>
          </button>

          <!-- Copy To… (⌘⇧C) -->
          <button class="tb-btn" id="btnCopyTo" title="Copy To… (⌘⇧C)">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <span class="tb-btn-label">Copy To…</span>
          </button>

          <!-- Trash (⌘⌫) -->
          <button class="tb-btn" id="btnTrash" title="Move to Trash (⌘⌫)">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3 6 5 6 21 6"/>
              <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
            </svg>
          </button>
        </div>

        <!-- Search Bar with Live Filter -->
        <div class="toolbar-search-box">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input type="text" id="demoSearchInput" placeholder="Search folder…" />
          <button class="clear-search-btn" id="btnClearSearch" style="display: none;">&times;</button>
        </div>
      </div>
    </div>

    <!-- Main App Split View: NavigationSplitView -->
    <div class="mac-app-container">
      
      <!-- Native macOS Sidebar -->
      <aside class="mac-native-sidebar" id="appSidebar">
        <!-- Section: Home -->
        <div class="sb-section">
          <button class="sb-row" data-folder="Home">
            <svg class="sb-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
            </svg>
            <span class="sb-label">Home</span>
          </button>
        </div>

        <!-- Section: Favorites -->
        <div class="sb-section">
          <div class="sb-section-header">Favorites</div>
          <button class="sb-row active" data-folder="Downloads">
            <svg class="sb-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="8 12 12 16 16 12"/>
              <line x1="12" y1="8" x2="12" y2="16"/>
            </svg>
            <span class="sb-label">Downloads</span>
          </button>

          <button class="sb-row" data-folder="Documents">
            <svg class="sb-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
            <span class="sb-label">Documents</span>
          </button>

          <button class="sb-row" data-folder="Desktop">
            <svg class="sb-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
            <span class="sb-label">Desktop</span>
          </button>

          <button class="sb-row" data-folder="Projects">
            <svg class="sb-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/>
            </svg>
            <span class="sb-label">Projects</span>
          </button>
        </div>

        <!-- Section: This Mac (Volumes) -->
        <div class="sb-section">
          <div class="sb-section-header">This Mac</div>
          
          <button class="sb-volume-item" data-folder="Macintosh HD">
            <div class="volume-icon internal">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2zm14 7a1 1 0 1 0 0-2 1 1 0 0 0 0 2z"/>
              </svg>
            </div>
            <div class="volume-meta">
              <span class="volume-name">Macintosh HD</span>
              <span class="volume-sub">494 GB • 312 GB free</span>
            </div>
          </button>

          <button class="sb-volume-item" data-folder="External SSD">
            <div class="volume-icon external">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
                <path d="M6 2h12a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm6 14a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/>
              </svg>
            </div>
            <div class="volume-meta">
              <span class="volume-name">External SSD</span>
              <span class="volume-sub">1.8 TB • 940 GB free</span>
            </div>
          </button>
        </div>

        <!-- Section: Recent Locations -->
        <div class="sb-section">
          <div class="sb-section-header">Recent Locations</div>
          <button class="sb-row" data-folder="Finance & Invoices">
            <svg class="sb-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span class="sb-label">Finance &amp; Invoices</span>
          </button>
        </div>
      </aside>

      <!-- Detail Work Area -->
      <div class="mac-detail-area">
        
        <!-- Tab Strip View (Matches tabStripView in MainView.swift) -->
        <div class="mac-tab-strip">
          <div class="tab-items-scroll" id="tabItemsScroll">
            <!-- Tabs rendered dynamically -->
          </div>
        </div>

        <!-- Panes Area: HSplitView (Single or Dual Panes) -->
        <div class="mac-panes-container split-active" id="panesWrapper">
          
          <!-- PANE 1: Left Pane -->
          <div class="pane-column pane-focused" id="leftPane" data-side="left">
            <!-- Pane Header: Navigation buttons + Breadcrumbs + View mode -->
            <div class="pane-navbar">
              <div class="nav-history-buttons">
                <button class="nav-arrow-btn" id="btnLeftBack" title="Back (⌘[)">‹</button>
                <button class="nav-arrow-btn disabled" id="btnLeftForward" title="Forward (⌘])">›</button>
                <button class="nav-arrow-btn" id="btnLeftUp" title="Enclosing Folder (⌘↑)">↑</button>
              </div>

              <!-- Interactive BreadcrumbBar -->
              <div class="breadcrumb-bar" id="leftBreadcrumbBar">
                <!-- Injected dynamically -->
              </div>

              <!-- Segmented View Mode Picker -->
              <div class="view-mode-picker">
                <button class="vm-btn active" data-mode="list" title="Details List View">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="8" y1="6" x2="21" y2="6"/>
                    <line x1="8" y1="12" x2="21" y2="12"/>
                    <line x1="8" y1="18" x2="21" y2="18"/>
                    <line x1="3" y1="6" x2="3.01" y2="6"/>
                    <line x1="3" y1="12" x2="3.01" y2="12"/>
                    <line x1="3" y1="18" x2="3.01" y2="18"/>
                  </svg>
                </button>
                <button class="vm-btn" data-mode="grid" title="Icon Grid View">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7"/>
                    <rect x="14" y="3" width="7" height="7"/>
                    <rect x="14" y="14" width="7" height="7"/>
                    <rect x="3" y="14" width="7" height="7"/>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Content Area: Table / Grid -->
            <div class="pane-content-container" id="leftContentContainer">
              <table class="mac-file-table" id="leftFileTable">
                <thead>
                  <tr>
                    <th class="col-th col-th-name">Name <span class="sort-indicator">▾</span></th>
                    <th class="col-th col-th-date">Date Modified</th>
                    <th class="col-th col-th-size">Size</th>
                    <th class="col-th col-th-kind">Kind</th>
                  </tr>
                </thead>
                <tbody id="leftTableBody">
                  <!-- Rendered dynamically -->
                </tbody>
              </table>
              <div class="mac-icon-grid" id="leftIconGrid" style="display: none;"></div>
            </div>
          </div>

          <!-- Split View Resizer Handle -->
          <div class="pane-split-divider" id="splitDivider" title="Drag to resize"></div>

          <!-- PANE 2: Right Pane -->
          <div class="pane-column" id="rightPane" data-side="right">
            <!-- Pane Header -->
            <div class="pane-navbar">
              <div class="nav-history-buttons">
                <button class="nav-arrow-btn" id="btnRightBack" title="Back (⌘[)">‹</button>
                <button class="nav-arrow-btn disabled" id="btnRightForward" title="Forward (⌘])">›</button>
                <button class="nav-arrow-btn" id="btnRightUp" title="Enclosing Folder (⌘↑)">↑</button>
              </div>

              <!-- BreadcrumbBar for Right Pane -->
              <div class="breadcrumb-bar" id="rightBreadcrumbBar">
                <!-- Injected dynamically -->
              </div>

              <!-- Segmented View Mode Picker -->
              <div class="view-mode-picker">
                <button class="vm-btn active" data-mode="list" title="Details List View">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="8" y1="6" x2="21" y2="6"/>
                    <line x1="8" y1="12" x2="21" y2="12"/>
                    <line x1="8" y1="18" x2="21" y2="18"/>
                    <line x1="3" y1="6" x2="3.01" y2="6"/>
                    <line x1="3" y1="12" x2="3.01" y2="12"/>
                    <line x1="3" y1="18" x2="3.01" y2="18"/>
                  </svg>
                </button>
                <button class="vm-btn" data-mode="grid" title="Icon Grid View">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7"/>
                    <rect x="14" y="3" width="7" height="7"/>
                    <rect x="14" y="14" width="7" height="7"/>
                    <rect x="3" y="14" width="7" height="7"/>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Right Content Area -->
            <div class="pane-content-container" id="rightContentContainer">
              <table class="mac-file-table" id="rightFileTable">
                <thead>
                  <tr>
                    <th class="col-th col-th-name">Name <span class="sort-indicator">▾</span></th>
                    <th class="col-th col-th-date">Date Modified</th>
                    <th class="col-th col-th-size">Size</th>
                    <th class="col-th col-th-kind">Kind</th>
                  </tr>
                </thead>
                <tbody id="rightTableBody">
                  <!-- Rendered dynamically -->
                </tbody>
              </table>
              <div class="mac-icon-grid" id="rightIconGrid" style="display: none;"></div>
            </div>
          </div>

        </div>

        <!-- Native StatusFooterView (Matches StatusFooterView.swift) -->
        <div class="mac-status-footer">
          <div class="sf-left">
            <span class="sf-status-icon">✓</span>
            <span class="sf-status-msg" id="statusMsg">Ready</span>
          </div>

          <div class="sf-right">
            <!-- Safe Undo indicator -->
            <button class="sf-undo-btn" id="btnUndo" title="Undo Last Operation (⌘Z)" style="display: none;">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M3 7v6h6"/>
                <path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/>
              </svg>
              <span>Undo (⌘Z)</span>
            </button>

            <span class="sf-sep" id="undoSep" style="display: none;"></span>

            <!-- Count & Selection summary -->
            <span class="sf-summary" id="selectionSummary">5 items (98.2 MB)</span>

            <span class="sf-sep"></span>

            <!-- Disk capacity gauge -->
            <span class="sf-capacity">Macintosh HD: 312 GB free</span>
          </div>
        </div>

      </div>
    </div>

    <!-- Native DestinationPickerSheet (Move To… / Copy To…) -->
    <div class="mac-sheet-overlay" id="moveToSheet" style="display: none;">
      <div class="mac-sheet-dialog">
        <div class="sheet-title-row">
          <div class="st-left">
            <span class="st-title" id="sheetModalTitle">Move To…</span>
            <span class="st-sub" id="sheetModalSub">1 item selected: <code id="sheetSelectedFileName">invoice_client_march.pdf</code></span>
          </div>
          <button class="st-close" id="closeSheetBtn">&times;</button>
        </div>

        <!-- Sheet Search Bar -->
        <div class="sheet-search-bar">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input type="text" id="sheetSearchInput" placeholder="Search recent or favorite folders…" />
        </div>

        <!-- Sheet List with Sections -->
        <div class="sheet-dest-list" id="sheetDestList">
          <div class="sheet-group-label">FAVORITES &amp; RECENT</div>

          <div class="sheet-row selected" data-dest="Finance & Invoices">
            <div class="dest-icon folder">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="#0A84FF"><path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
            </div>
            <div class="dest-text">
              <span class="dest-title">Finance &amp; Invoices</span>
              <span class="dest-url">~/Projects/Finance &amp; Invoices</span>
            </div>
            <span class="kbd-hint">↵ Enter</span>
          </div>

          <div class="sheet-row" data-dest="Client_Contracts">
            <div class="dest-icon folder">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="#0A84FF"><path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
            </div>
            <div class="dest-text">
              <span class="dest-title">Client_Contracts</span>
              <span class="dest-url">~/Projects/Client_Contracts</span>
            </div>
          </div>

          <div class="sheet-row" data-dest="Documents">
            <div class="dest-icon folder">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="#0A84FF"><path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
            </div>
            <div class="dest-text">
              <span class="dest-title">Documents</span>
              <span class="dest-url">~/Documents</span>
            </div>
          </div>

          <div class="sheet-row" data-dest="External SSD">
            <div class="dest-icon drive">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="#EA580C"><path d="M6 2h12a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm6 14a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z"/></svg>
            </div>
            <div class="dest-text">
              <span class="dest-title">External SSD / Backup</span>
              <span class="dest-url">/Volumes/External SSD/Backups_2026</span>
            </div>
          </div>
        </div>

        <!-- Sheet Action Buttons -->
        <div class="sheet-actions-row">
          <button class="sheet-btn cancel" id="cancelSheetBtn">Cancel</button>
          <button class="sheet-btn confirm" id="confirmSheetBtn">Move</button>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Global Scoped Styles: Ensures dynamically generated DOM elements receive 100% full styling -->
<style is:global>
  .demo-container {
    margin-top: 2.5rem;
    margin-bottom: 2rem;
    position: relative;
    width: 100%;
    max-width: 1080px;
  }

  .demo-container .demo-interactive-hint {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    box-shadow: var(--shadow-sm);
  }

  .demo-container .hint-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-accent);
    border-radius: 50%;
    animation: demoPulse 2s infinite;
  }

  @keyframes demoPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  /* macOS Window Frame */
  .demo-container .mac-window {
    background: #FFFFFF;
    border-radius: 12px;
    box-shadow: 0 24px 60px -12px rgba(15, 23, 42, 0.22), 0 0 0 1px rgba(0, 0, 0, 0.12);
    overflow: hidden;
    position: relative;
    text-align: left;
    user-select: none;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", system-ui, sans-serif;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  /* Unified Top Titlebar */
  .demo-container .mac-unified-titlebar {
    display: flex;
    background: #ECEEEF;
    border-bottom: 1px solid #D1D5DB;
    height: 48px;
  }

  .demo-container .titlebar-left {
    width: 210px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    border-right: 1px solid #D1D5DB;
    background: #E8EAEA;
    transition: width 0.18s ease;
  }

  .demo-container .titlebar-left.collapsed {
    width: 70px;
  }

  .demo-container .traffic-lights {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .demo-container .light {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
    cursor: pointer;
  }

  .demo-container .light.close { background: #FF5F56; border: 1px solid #E0443E; }
  .demo-container .light.minimize { background: #FFBD2E; border: 1px solid #DEA123; }
  .demo-container .light.maximize { background: #27C93F; border: 1px solid #1AAB29; }

  .demo-container .sidebar-toggle-btn {
    color: #64748B;
    padding: 4px;
    border-radius: 5px;
    display: flex;
    align-items: center;
    cursor: pointer;
    background: none;
    border: none;
  }

  .demo-container .sidebar-toggle-btn:hover {
    background: rgba(0, 0, 0, 0.08);
    color: #0F172A;
  }

  /* Detail Toolbar */
  .demo-container .titlebar-detail {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    gap: 12px;
  }

  .demo-container .toolbar-actions {
    display: flex;
    align-items: center;
