---
// Hero.astro
import HeroDemo from './HeroDemo.astro';
---

<section class="hero-section" id="overview">
  <div class="container hero-container">
    <div class="hero-content">
      <!-- Minimal Apple-Style Product Tag -->
      <div class="hero-eyebrow-wrap">
        <span class="hero-eyebrow">Maggo for Mac</span>
      </div>

      <!-- Core Apple-Style Headline: Exactly Aligned With Positioning -->
      <h1 class="hero-headline">
        Managing files on Mac <br class="br-desktop" />
        <span class="hero-headline-dim">feels simple again.</span>
      </h1>

      <!-- Clear, Calm, Human Subhead (Zero AI Hype) -->
      <p class="hero-subhead">
        A fast, native file manager designed to replace multi-window Finder clutter with calm, single-window focus. Dual panes, instant tabs, and direct keyboard moves.
      </p>

      <!-- Primary Action Buttons -->
      <div class="hero-actions">
        <a href="#pricing" class="btn btn-primary btn-lg hero-cta-btn">
          <span>Try Free for 3 Days</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>

        <a href="#demo" class="btn btn-secondary btn-lg hero-demo-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
          <span>Try the Live Demo</span>
        </a>
      </div>

      <!-- Clear, Transparent Pricing Terms -->
      <div class="hero-pricing-terms">
        <span class="terms-highlight">3-Day Free Trial ($0 today).</span>
        <span class="terms-sub">$19.99 one-time purchase. Lifetime updates. No subscriptions.</span>
      </div>

      <!-- Apple Hardware & macOS Heritage Callout -->
      <div class="hero-specs-row">
        <span class="spec-pill">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-2 .6-2.65 1.35-.58.67-.99 1.74-.85 2.78 1.01.08 2.05-.53 2.58-1.28z"/>
          </svg>
          macOS 14+ Sonoma &amp; Sequoia
        </span>
        <span class="spec-separator">•</span>
        <span class="spec-pill">Apple Silicon &amp; Intel</span>
        <span class="spec-separator">•</span>
        <span class="spec-pill">Native Swift 6 &amp; SwiftUI</span>
        <span class="spec-separator">•</span>
        <span class="spec-pill">100% Offline &amp; Private</span>
      </div>
    </div>

    <!-- Product Demonstration (The Interactive Mac Window) -->
    <div class="hero-demo-stage" id="demo">
      <div class="demo-ambient-glow"></div>
      <HeroDemo />
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 5rem;
    padding-bottom: 6rem;
    background: radial-gradient(circle at 50% -10%, rgba(136, 84, 208, 0.07) 0%, transparent 65%), #FFFFFF;
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-content {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-eyebrow-wrap {
    margin-bottom: 1.5rem;
  }

  .hero-eyebrow {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    border: 1px solid var(--color-accent-border);
    padding: 0.35rem 1rem;
    border-radius: var(--radius-pill);
    display: inline-block;
  }

  .hero-headline {
    font-size: 3.25rem;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-text-main);
    margin-bottom: 1.5rem;
  }

  .hero-headline-dim {
    color: #475569;
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .hero-headline {
      font-size: 4.5rem;
    }
    .br-desktop {
      display: inline;
    }
  }

  @media (max-width: 767px) {
    .br-desktop {
      display: none;
    }
  }

  .hero-subhead {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: 2.25rem;
    max-width: 680px;
    letter-spacing: -0.015em;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .hero-cta-btn {
    box-shadow: 0 4px 20px rgba(136, 84, 208, 0.35);
  }

  .hero-demo-btn {
    background: #FFFFFF;
    color: var(--color-text-body);
  }

  .hero-pricing-terms {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .terms-highlight {
    font-weight: 600;
    color: var(--color-text-main);
  }

  .hero-specs-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.8125rem;
    color: #64748B;
    margin-bottom: 4rem;
  }

  .spec-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .spec-separator {
    color: #CBD5E1;
  }

  /* Interactive Stage Lighting */
  .hero-demo-stage {
    width: 100%;
    position: relative;
  }

  .demo-ambient-glow {
    position: absolute;
    top: -10%;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    height: 60%;
    background: radial-gradient(ellipse at center, rgba(136, 84, 208, 0.12) 0%, transparent 70%);
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
  }
</style>
