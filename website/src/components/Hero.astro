---
// Hero.astro
import HeroDemo from './HeroDemo.astro';
---

<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-content">
      <!-- Semantic H1 aligned with topical SEO strategy -->
      <div class="hero-badge-wrap">
        <h1 class="hero-eyebrow">A better file manager for Mac.</h1>
      </div>

      <!-- Core Outcome Headline -->
      <p class="hero-headline">
        File management that <span class="headline-accent">finally feels simple.</span>
      </p>

      <!-- Subtitle naturally establishing SEO & context -->
      <p class="hero-subhead">
        Maggo is a fast, familiar file manager for Mac that makes it easier to find, navigate, move, copy, and organize your files.
      </p>

      <!-- Differentiation Pillars -->
      <div class="hero-pillars">
        <span class="pillar-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          No AI gimmickry
        </span>
        <span class="pillar-dot">•</span>
        <span class="pillar-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          No complicated workflows
        </span>
        <span class="pillar-dot">•</span>
        <span class="pillar-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          No subscription
        </span>
      </div>

      <!-- Price & Value Proposition Callout -->
      <div class="hero-pricing-badge">
        <span class="price-amount">3-Day Free Trial ($0 Today).</span>
        <span class="price-details">Then $19.99 once for lifetime access.</span>
      </div>

      <!-- Primary Action CTAs: 3-Day Trial Flow -->
      <div class="hero-actions">
        <a href="#pricing" class="btn btn-primary btn-lg hero-cta-btn">
          <span>Start 3-Day Free Trial</span>
        </a>

        <a href="#demo" class="btn btn-secondary btn-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <polygon points="10 8 16 12 10 16 10 8"/>
          </svg>
          <span>See how it works</span>
        </a>
      </div>

      <p class="hero-payment-note">Add card at checkout • $0 charged today • Auto-renews to $19.99 once on Day 3 • Cancel anytime</p>

      <!-- 3-Day Trial Explainer -->
      <div class="hero-trial-block">
        <span class="trial-pill">3-Day Full Trial</span>
        <span>
          Experience full unhindered Maggo for 3 days. On day 3, your $19.99 one-time lifetime license activates automatically unless cancelled.
        </span>
      </div>

      <!-- Native macOS compatibility badge -->
      <div class="hero-system-reqs">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-2 .6-2.65 1.35-.58.67-.99 1.74-.85 2.78 1.01.08 2.05-.53 2.58-1.28z"/>
        </svg>
        <span>Works natively on macOS 14+ (Sonoma &amp; Sequoia). Apple Silicon &amp; Intel.</span>
      </div>
    </div>

    <!-- Product Demonstration (The Mac Window) -->
    <HeroDemo />
  </div>
</section>

<style>
  .hero-section {
    padding-top: 4.5rem;
    padding-bottom: 3.5rem;
    background: radial-gradient(circle at 50% -20%, rgba(136, 84, 208, 0.08), transparent 70%);
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-content {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-badge-wrap {
    margin-bottom: 1.25rem;
  }

  .hero-eyebrow {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    border: 1px solid var(--color-accent-border);
    padding: 0.4rem 1.1rem;
    border-radius: 9999px;
    letter-spacing: -0.01em;
    display: inline-block;
  }

  .hero-headline {
    font-size: 3rem;
    line-height: 1.12;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-text-main);
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .hero-headline {
      font-size: 4rem;
    }
  }

  .headline-accent {
    color: var(--color-accent);
  }

  .hero-subhead {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-text-body);
    margin-bottom: 1.5rem;
    max-width: 700px;
  }

  .hero-pillars {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .pillar-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #1E293B;
  }

  .pillar-item svg {
    color: #10B981;
  }

  .pillar-dot {
    color: #CBD5E1;
  }

  .hero-pricing-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #F1F5F9;
    border: 1px solid var(--color-border);
    padding: 0.45rem 1.25rem;
    border-radius: 9999px;
    margin-bottom: 2rem;
  }

  .price-amount {
    font-size: 1.0625rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .price-details {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .hero-payment-note {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    margin-top: -0.75rem;
    margin-bottom: 1.5rem;
  }

  .hero-trial-block {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: #F8FAFC;
    border: 1px solid var(--color-border);
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    color: var(--color-text-body);
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .trial-pill {
    background: #DCFCE7;
    color: #15803D;
    font-weight: 700;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
  }

  .trial-link {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .trial-link:hover {
    color: var(--color-accent-hover);
  }

  .hero-system-reqs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .hero-system-reqs svg {
    color: #475569;
  }
</style>
