---
// Hero.astro
---

<section class="hero-section" id="overview">
  <!-- NotchBuddy-style Ambient Top Glows -->
  <div class="hero-glow-layer-top" aria-hidden="true"></div>
  <div class="hero-glow-layer-center" aria-hidden="true"></div>

  <div class="container hero-container">
    <div class="hero-content">
      <!-- NotchBuddy Pill Eyebrow with Glow Dot -->
      <div class="hero-eyebrow-wrap">
        <span class="hero-eyebrow">
          <span class="glow-dot"></span>
          100% Free for Mac • Native Swift 6 &amp; SwiftUI
        </span>
      </div>

      <!-- Display Headline with Serif Italic Accent -->
      <h1 class="hero-headline">
        Managing files on Mac <br class="br-desktop" />
        <span class="accent-serif">feels simple again.</span>
      </h1>

      <!-- Clear, Human Subhead (Zero AI Hype) -->
      <p class="hero-subhead">
        Maggo brings dual-pane split views, direct Move To workflows, drive health, and multi-tab organization to macOS — fast, calm, and 100% free.
      </p>

      <!-- Primary Action Buttons (NotchBuddy style) -->
      <div class="hero-actions">
        <a href="/downloads/Maggo-macOS.dmg" download class="btn btn-primary btn-lg hero-cta-btn">
          <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
            <path d="M16.4 12.7c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9s-2-.9-3.3-.8c-1.7 0-3.3 1-4.1 2.5-1.8 3.1-.5 7.6 1.3 10.1.9 1.2 1.9 2.6 3.2 2.5 1.3 0 1.8-.8 3.3-.8s2 .8 3.3.8 2.2-1.2 3.1-2.4c1-1.4 1.4-2.7 1.4-2.8-.1 0-2.7-1-2.7-4.1zM14 5.3c.7-.8 1.2-2 1-3.3-1 0-2.3.7-3 1.5-.7.8-1.2 2-1 3.2 1.1 0 2.3-.6 3-1.4z"/>
          </svg>
          <span>Download for macOS — Free</span>
        </a>

        <a href="#features" class="btn btn-secondary btn-lg hero-demo-btn">
          <span>Explore all features &darr;</span>
        </a>
      </div>

      <!-- Launch note -->
      <p class="hero-launch-note">
        Free download • macOS 14 Sonoma &amp; 15 Sequoia • No ads or subscriptions.
      </p>

      <!-- Trust Points Row with Colored Glow Dots -->
      <ul class="hero-trust-list">
        <li><span class="bullet-dot"></span>100% Free Forever</li>
        <li><span class="bullet-dot"></span>Everything stays on your Mac</li>
        <li><span class="bullet-dot"></span>100% Native Swift 6 &amp; SwiftUI</li>
        <li><span class="bullet-dot"></span>Apple Silicon &amp; Intel</li>
      </ul>
    </div>

    <!-- Product Showcase Canvas (NotchBuddy Frame with Real Dual Pane Screenshot) -->
    <div class="hero-showcase-stage">
      <div class="stage-backdrop-glow"></div>
      <div class="stage-mac-window">
        <div class="stage-traffic-lights">
          <span class="t-light close"></span>
          <span class="t-light min"></span>
          <span class="t-light zoom"></span>
          <span class="stage-title-tag">Maggo — Dual Split Workspace</span>
        </div>
        <img 
          src="/images/screenshots/maggo-dual-pane.png" 
          alt="Maggo Native macOS File Manager Dual Pane Split View" 
          class="stage-screenshot"
          width="898"
          height="567"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 8rem;
    padding-bottom: 6rem;
    position: relative;
    overflow: hidden;
    background-color: var(--color-bg);
  }

  @media (max-width: 640px) {
    .hero-section {
      padding-top: 6.5rem;
      padding-bottom: 4rem;
    }
  }

  .hero-glow-layer-top {
    position: absolute;
    left: 50%;
    top: -16rem;
    width: 60rem;
    height: 34rem;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(136, 84, 208, 0.22) 0%, transparent 70%);
    filter: blur(100px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-glow-layer-center {
    position: absolute;
    left: 50%;
    top: 4rem;
    width: 32rem;
    height: 20rem;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.14) 0%, transparent 70%);
    filter: blur(90px);
    pointer-events: none;
    z-index: 0;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .hero-content {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-eyebrow-wrap {
    margin-bottom: 1.5rem;
  }

  .hero-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-main);
    background: #FFFFFF;
    border: 1px solid var(--color-border-strong);
    padding: 0.35rem 0.95rem;
    border-radius: var(--radius-pill);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    box-shadow: var(--shadow-xs);
  }

  .hero-headline {
    font-size: 2.85rem;
    line-height: 1.08;
    font-weight: 800;
    letter-spacing: -0.035em;
    color: var(--color-text-main);
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .hero-headline {
      font-size: 4.25rem;
    }
  }

  .br-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .br-desktop {
      display: inline;
    }
  }

  .hero-subhead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text-body);
    max-width: 620px;
    margin-bottom: 2.25rem;
  }

  @media (max-width: 640px) {
    .hero-subhead {
      font-size: 1rem;
    }
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .hero-cta-btn {
    box-shadow: 0 14px 40px -10px rgba(136, 84, 208, 0.6);
  }

  .hero-launch-note {
    font-size: 0.82rem;
    color: var(--color-text-faint);
    margin-bottom: 2rem;
  }

  .hero-trust-list {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .hero-trust-list li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .bullet-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* Showcase Stage */
  .hero-showcase-stage {
    margin-top: 4rem;
    width: 100%;
    max-width: 1020px;
    position: relative;
  }

  .stage-backdrop-glow {
    position: absolute;
    inset: -20px;
    background: radial-gradient(circle at 50% 30%, rgba(136, 84, 208, 0.28) 0%, rgba(245, 158, 11, 0.1) 60%, transparent 80%);
    filter: blur(60px);
    border-radius: 40px;
    pointer-events: none;
    z-index: 0;
  }

  .stage-mac-window {
    position: relative;
    z-index: 1;
    background: #0F1015;
    border-radius: 18px;
    border: 4px solid #0F1015;
    box-shadow: var(--shadow-stage);
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .stage-mac-window {
      border-radius: 22px;
      border-width: 6px;
    }
  }

  .stage-traffic-lights {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: #0F1015;
  }

  .t-light {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .t-light.close { background: #FF5F56; }
  .t-light.min { background: #FFBD2E; }
  .t-light.zoom { background: #27C93F; }

  .stage-title-tag {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: rgba(255, 255, 255, 0.4);
    margin-left: auto;
    margin-right: auto;
  }

  .stage-screenshot {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
