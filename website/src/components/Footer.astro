---
// Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-main-row">
      <div class="footer-brand-side">
        <a href="/" class="footer-brand" aria-label="Maggo Home">
          <img src={`${import.meta.env.BASE_URL}/images/maggo-logo.png`} alt="Maggo Logo" class="brand-logo-img" width="28" height="28" />
          <span class="brand-title">Maggo</span>
        </a>
        <p class="brand-pitch">
          A faster, simpler file manager that makes Mac organization feel calm again.
        </p>
      </div>

      <div class="footer-nav-side">
        <a href="#features" class="footer-link">Features</a>
        <a href="#comparison" class="footer-link">Why Maggo</a>
        <a href="#download" class="footer-link">Download</a>
        <a href="#faq" class="footer-link">FAQ</a>
        <a href={`${import.meta.env.BASE_URL}/downloads/Maggo-macOS.dmg`} download class="footer-link cta-link">Download Free &rarr;</a>
      </div>
    </div>

    <div class="footer-divider"></div>

    <div class="footer-bottom-row">
      <div class="footer-privacy-pill">
        <span class="glow-dot"></span>
        <span>100% Offline &amp; Private • Zero Telemetry</span>
      </div>

      <div class="footer-legal">
        <span>&copy; {currentYear} Maggo. All rights reserved.</span>
        <span>macOS, Finder, Sonoma, and Sequoia are trademarks of Apple Inc.</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-warm);
    border-top: 1px solid var(--color-border);
    padding-top: 3.5rem;
    padding-bottom: 3rem;
    font-size: 0.85rem;
  }

  .footer-main-row {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;
    justify-content: space-between;
  }

  @media (min-width: 768px) {
    .footer-main-row {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer-brand-side {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-text-main);
  }

  .brand-logo-img {
    border-radius: 6px;
    display: block;
  }

  .brand-pitch {
    color: var(--color-text-muted);
    font-size: 0.85rem;
    max-width: 320px;
  }

  .footer-nav-side {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .footer-link {
    font-weight: 500;
    color: var(--color-text-body);
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: var(--color-accent);
  }

  .footer-link.cta-link {
    color: var(--color-accent);
    font-weight: 600;
  }

  .footer-divider {
    height: 1px;
    background: var(--color-border);
    margin: 2.25rem 0 1.75rem 0;
  }

  .footer-bottom-row {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
    justify-content: space-between;
  }

  @media (min-width: 768px) {
    .footer-bottom-row {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer-privacy-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-main);
    background: #FFFFFF;
    border: 1px solid var(--color-border-strong);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-xs);
  }

  .footer-legal {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.75rem;
    color: var(--color-text-faint);
  }

  @media (min-width: 768px) {
    .footer-legal {
      text-align: right;
    }
  }
</style>
