---
// FeaturesSection.astro
---

<section class="section-wrapper features-section" id="features">
  <div class="container">
    <div class="section-header-center">
      <div class="section-eyebrow">Everything In One Place</div>
      <h2 class="section-title">
        Tools designed for how you <br class="br-desktop" />
        <span class="accent-serif">actually organize files.</span>
      </h2>
      <p class="section-subtitle">
        Predictable, tactile file management with zero artificial complexity. Everything you need to find, move, and organize files in seconds.
      </p>
    </div>

    <!-- 4 Detailed Showcase Modules with NotchBuddy-style Colored Stages -->
    <div class="showcases-container">
      
      <!-- Showcase 1: Dual Pane Split View -->
      <div class="showcase-card">
        <div class="showcase-header-text">
          <span class="showcase-pill">Feature 01 • Dual Split View</span>
          <h3 class="showcase-title">
            Two folders side by side. <br class="br-desktop"/>
            <span class="accent-serif">Without the window sprawl.</span>
          </h3>
          <p class="showcase-lead">
            Open two directories side by side with a single shortcut (<span class="kbd-key">⌘⇧S</span>). Drag files directly from source to destination without opening new windows or losing your place on the desktop.
          </p>

          <div class="feature-tag-list">
            <span class="f-tag">Instant drag-and-drop</span>
            <span class="f-tag">Independent folder paths</span>
            <span class="f-tag">Shortcut: ⌘⇧S</span>
          </div>
        </div>

        <!-- NotchBuddy Colored Gradient Stage -->
        <div class="stage-gradient-wrap stage-purple">
          <div class="stage-mac-window">
            <div class="stage-traffic-lights">
              <span class="t-light close"></span>
              <span class="t-light min"></span>
              <span class="t-light zoom"></span>
            </div>
            <img 
              src={`${import.meta.env.BASE_URL}/images/screenshots/maggo-dual-pane.png`} 
              alt="Maggo Dual Pane Split View Screenshot" 
              class="screenshot-img" 
              loading="lazy"
            />
          </div>
        </div>

        <!-- Finder vs Maggo Comparison Box -->
        <div class="contrast-box">
          <div class="contrast-row missing">
            <span class="contrast-tag finder-tag">Missing in Finder</span>
            <p class="contrast-desc">
              Forced to open 2 separate Finder windows, manually align them across your screen, and risk misdropping files onto your desktop.
            </p>
          </div>
          <div class="contrast-row solved">
            <span class="contrast-tag maggo-tag">The Maggo Solution</span>
            <p class="contrast-desc">
              Press <span class="kbd-key">⌘⇧S</span> for an instant dual split pane. Both sides have independent breadcrumbs and folder navigation for 100% drag precision.
            </p>
          </div>
        </div>
      </div>

      <!-- Showcase 2: Move To & Copy To Dialog -->
      <div class="showcase-card">
        <div class="showcase-header-text">
          <span class="showcase-pill">Feature 02 • Direct Move</span>
          <h3 class="showcase-title">
            Move files instantly. <br class="br-desktop"/>
            <span class="accent-serif">Zero folder scavenger hunts.</span>
          </h3>
          <p class="showcase-lead">
            Moving a file shouldn't mean dragging across 8 nested directories. Select any item, press <span class="kbd-key">⌘⇧M</span>, search your destination with instant fuzzy matching, and press Return.
          </p>

          <div class="feature-tag-list">
            <span class="f-tag">Fuzzy folder search</span>
            <span class="f-tag">No mouse dragging</span>
            <span class="f-tag">Shortcut: ⌘⇧M</span>
          </div>
        </div>

        <!-- NotchBuddy Colored Gradient Stage (Amber) -->
        <div class="stage-gradient-wrap stage-amber">
          <div class="stage-mac-window">
            <div class="stage-traffic-lights">
              <span class="t-light close"></span>
              <span class="t-light min"></span>
              <span class="t-light zoom"></span>
            </div>
            <img 
              src={`${import.meta.env.BASE_URL}/images/screenshots/maggo-move-to-window.png`} 
              alt="Maggo Move To Dialog Screenshot" 
              class="screenshot-img" 
              loading="lazy"
            />
          </div>
        </div>

        <!-- Finder vs Maggo Comparison Box -->
        <div class="contrast-box">
          <div class="contrast-row missing">
            <span class="contrast-tag finder-tag">Missing in Finder</span>
            <p class="contrast-desc">
              Requires dragging across nested folders, waiting for auto-expanding spring folders, or tedious copy-paste sequences.
            </p>
          </div>
          <div class="contrast-row solved">
            <span class="contrast-tag maggo-tag">The Maggo Solution</span>
            <p class="contrast-desc">
              Select any item, press <span class="kbd-key">⌘⇧M</span>, search your destination with instant fuzzy matching, and press Return. Relocate files in 2 seconds flat.
            </p>
          </div>
        </div>
      </div>

      <!-- Showcase 3: Drive Storage Capacity -->
      <div class="showcase-card">
        <div class="showcase-header-text">
          <span class="showcase-pill">Feature 03 • Drive Health</span>
          <h3 class="showcase-title">
            Live storage metrics. <br class="br-desktop"/>
            <span class="accent-serif">Always just one click away.</span>
          </h3>
          <p class="showcase-lead">
            Click Macintosh HD, external SSDs, or SD cards in the sidebar to immediately see exact gigabytes used, free space, and 1-click file browsing without digging through menus.
          </p>

          <div class="feature-tag-list">
            <span class="f-tag">Visual capacity bar</span>
            <span class="f-tag">External drive auto-detect</span>
            <span class="f-tag">1-Click browse</span>
          </div>
        </div>

        <!-- NotchBuddy Colored Gradient Stage (Blue/Sky) -->
        <div class="stage-gradient-wrap stage-sky">
          <div class="stage-mac-window">
            <div class="stage-traffic-lights">
              <span class="t-light close"></span>
              <span class="t-light min"></span>
              <span class="t-light zoom"></span>
            </div>
            <img 
              src={`${import.meta.env.BASE_URL}/images/screenshots/maggo-storage.png`} 
              alt="Maggo Storage Usage and Capacity Overview" 
              class="screenshot-img" 
              loading="lazy"
            />
          </div>
        </div>

        <!-- Finder vs Maggo Comparison Box -->
        <div class="contrast-box">
          <div class="contrast-row missing">
            <span class="contrast-tag finder-tag">Missing in Finder</span>
            <p class="contrast-desc">
              No visual storage progress gauge in the main view. Requires right-clicking to open "Get Info" dialogs or navigating System Settings.
            </p>
          </div>
          <div class="contrast-row solved">
            <span class="contrast-tag maggo-tag">The Maggo Solution</span>
            <p class="contrast-desc">
              Click Macintosh HD or any external SSD in the sidebar to immediately see exact gigabytes used, free space, and 1-click file browsing.
            </p>
          </div>
        </div>
      </div>

      <!-- Showcase 4: Smart Media & File Gallery -->
      <div class="showcase-card">
        <div class="showcase-header-text">
          <span class="showcase-pill">Feature 04 • Smart Media</span>
          <h3 class="showcase-title">
            Smart file filtering. <br class="br-desktop"/>
            <span class="accent-serif">That actually makes sense.</span>
          </h3>
          <p class="showcase-lead">
            Instant 1-click filter pills (Recently Modified, Large &gt;5MB, Format picker) with high-density visual thumbnails and source directory badges.
          </p>

          <div class="feature-tag-list">
            <span class="f-tag">Large file filter (&gt; 5 MB)</span>
            <span class="f-tag">Format selector</span>
            <span class="f-tag">Recent modifications</span>
          </div>
        </div>

        <!-- NotchBuddy Colored Gradient Stage (Emerald) -->
        <div class="stage-gradient-wrap stage-emerald">
          <div class="stage-mac-window">
            <div class="stage-traffic-lights">
              <span class="t-light close"></span>
              <span class="t-light min"></span>
              <span class="t-light zoom"></span>
            </div>
            <img 
              src={`${import.meta.env.BASE_URL}/images/screenshots/maggo-smart-pictures.png`} 
              alt="Maggo Smart Pictures Gallery with Quick Filters" 
              class="screenshot-img" 
              loading="lazy"
            />
          </div>
        </div>

        <!-- Finder vs Maggo Comparison Box -->
        <div class="contrast-box">
          <div class="contrast-row missing">
            <span class="contrast-tag finder-tag">Missing in Finder</span>
            <p class="contrast-desc">
              Building custom smart search queries requires 5+ clicks in Spotlight filters that reset every time you close the window.
            </p>
          </div>
          <div class="contrast-row solved">
            <span class="contrast-tag maggo-tag">The Maggo Solution</span>
            <p class="contrast-desc">
              Instant 1-click filter pills (Recently Modified, Large &gt;5MB, Format picker) with high-density visual thumbnails and source directory badges.
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .features-section {
    background-color: var(--color-bg);
    position: relative;
  }

  .section-header-center {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 5rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .br-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .br-desktop {
      display: inline;
    }
  }

  .showcases-container {
    display: flex;
    flex-direction: column;
    gap: 7rem;
  }

  .showcase-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 1020px;
    margin: 0 auto;
    width: 100%;
  }

  .showcase-header-text {
    max-width: 760px;
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .showcase-pill {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    background: #FFFFFF;
    border: 1px solid var(--color-border-strong);
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1.25rem;
    box-shadow: var(--shadow-xs);
  }

  .showcase-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--color-text-main);
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .showcase-title {
      font-size: 3rem;
    }
  }

  .showcase-lead {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-text-body);
    max-width: 620px;
    margin-bottom: 1.5rem;
  }

  .feature-tag-list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .f-tag {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-main);
    background: var(--color-bg-warm);
    border: 1px solid var(--color-border-strong);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
  }

  /* NotchBuddy Gradient Showcase Stages */
  .stage-gradient-wrap {
    width: 100%;
    border-radius: 24px;
    padding: 2.5rem 1.5rem 2rem 1.5rem;
    position: relative;
    box-shadow: var(--shadow-md);
    margin-bottom: 2.5rem;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .stage-gradient-wrap {
      padding: 4rem 3.5rem 3rem 3.5rem;
      border-radius: 32px;
    }
  }

  .stage-purple {
    background: radial-gradient(125% 95% at 50% -20%, #FAF5FF 0%, #E9D5FF 40%, #8854D0 100%);
  }

  .stage-amber {
    background: radial-gradient(125% 95% at 50% -20%, #FFFBEB 0%, #FDE68A 40%, #F59E0B 100%);
  }

  .stage-sky {
    background: radial-gradient(125% 95% at 50% -20%, #F0F9FF 0%, #BAE6FD 40%, #0284C7 100%);
  }

  .stage-emerald {
    background: radial-gradient(125% 95% at 50% -20%, #ECFDF5 0%, #A7F3D0 40%, #059669 100%);
  }

  .stage-mac-window {
    background: #0F1015;
    border-radius: 14px;
    box-shadow: var(--shadow-stage);
    overflow: hidden;
    border: 4px solid #0F1015;
    max-width: 900px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .stage-mac-window {
      border-radius: 18px;
      border-width: 5px;
    }
  }

  .stage-traffic-lights {
    display: flex;
    gap: 6px;
    padding: 8px 12px;
    background: #0F1015;
  }

  .t-light {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .t-light.close { background: #FF5F56; }
  .t-light.min { background: #FFBD2E; }
  .t-light.zoom { background: #27C93F; }

  .screenshot-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* Contrast Box */
  .contrast-box {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    background: #FFFFFF;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    padding: 1.75rem 2rem;
    box-shadow: var(--shadow-sm);
    max-width: 820px;
    width: 100%;
    text-align: left;
  }

  @media (min-width: 768px) {
    .contrast-box {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  .contrast-row {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .contrast-tag {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
  }

  .finder-tag {
    background: #FEF2F2;
    color: #991B1B;
    border: 1px solid #FECACA;
  }

  .maggo-tag {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    border: 1px solid var(--color-accent-border);
  }

  .contrast-desc {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-text-body);
  }

  .contrast-row.solved .contrast-desc {
    color: var(--color-text-main);
    font-weight: 500;
  }
</style>
