---
// FeaturesSection.astro
---

<section class="section-wrapper features-section" id="features">
  <div class="container">
    <div class="section-header-center">
      <div class="section-eyebrow">Real macOS Workflows</div>
      <h2 class="section-title">
        Every detail designed to fix <br class="br-desktop" />what Finder made frustrating.
      </h2>
      <p class="section-subtitle">
        See how Maggo replaces messy window sprawl, slow folder traversal, and hidden disk metrics with clean, predictable tools.
      </p>
    </div>

    <!-- 4 Detailed Showcase Modules with Real Screenshots -->
    <div class="showcases-container">
      
      <!-- Showcase 1: Dual Pane Split View -->
      <div class="showcase-card">
        <div class="showcase-info">
          <span class="showcase-pill">Feature 01 • Split View</span>
          <h3 class="showcase-title">Two folders side by side. One single window.</h3>
          
          <!-- Finder vs Maggo Comparison Box -->
          <div class="contrast-box">
            <div class="contrast-row missing">
              <span class="contrast-tag finder-tag">Missing in Finder</span>
              <p class="contrast-desc">
                Forced to open 2 separate Finder windows, manually align them across your screen, and risk misdropping files onto your desktop.
              </p>
            </div>
            <div class="contrast-row solved">
              <span class="contrast-tag maggo-tag">The Maggo Way</span>
              <p class="contrast-desc">
                Press <span class="kbd-key">⌘⇧S</span> for an instant dual split pane. Both sides have independent breadcrumbs and folder navigation for 100% drag precision.
              </p>
            </div>
          </div>
        </div>
        <div class="showcase-media">
          <div class="mac-window-frame">
            <div class="frame-traffic-lights">
              <span class="t-light close"></span>
              <span class="t-light min"></span>
              <span class="t-light zoom"></span>
            </div>
            <img 
              src="/images/screenshots/maggo-dual-pane.png" 
              alt="Maggo Dual Pane Split View Screenshot" 
              class="screenshot-img" 
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <!-- Showcase 2: Move To & Copy To Dialog -->
      <div class="showcase-card reversed">
        <div class="showcase-info">
          <span class="showcase-pill">Feature 02 • Direct Move</span>
          <h3 class="showcase-title">Move To… without the folder scavenger hunt.</h3>
          
          <!-- Finder vs Maggo Comparison Box -->
          <div class="contrast-box">
            <div class="contrast-row missing">
              <span class="contrast-tag finder-tag">Missing in Finder</span>
              <p class="contrast-desc">
                Requires dragging across nested folders, waiting for auto-expanding spring folders, or tedious copy-paste sequences.
              </p>
            </div>
            <div class="contrast-row solved">
              <span class="contrast-tag maggo-tag">The Maggo Way</span>
              <p class="contrast-desc">
                Select any item, press <span class="kbd-key">⌘⇧M</span>, search your destination with instant fuzzy matching, and press Return. Relocate files in 2 seconds flat.
              </p>
            </div>
          </div>
        </div>
        <div class="showcase-media">
          <div class="mac-window-frame">
            <div class="frame-traffic-lights">
              <span class="t-light close"></span>
              <span class="t-light min"></span>
              <span class="t-light zoom"></span>
            </div>
            <img 
              src="/images/screenshots/maggo-move-to-window.png" 
              alt="Maggo Move To Dialog Screenshot" 
              class="screenshot-img" 
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <!-- Showcase 3: Drive Storage Capacity -->
      <div class="showcase-card">
        <div class="showcase-info">
          <span class="showcase-pill">Feature 03 • Storage Health</span>
          <h3 class="showcase-title">Instant drive metrics &amp; capacity at a glance.</h3>
          
          <!-- Finder vs Maggo Comparison Box -->
          <div class="contrast-box">
            <div class="contrast-row missing">
              <span class="contrast-tag finder-tag">Missing in Finder</span>
              <p class="contrast-desc">
                No visual storage progress gauge in the main view. Requires right-clicking to open "Get Info" dialogs or navigating System Settings.
              </p>
            </div>
            <div class="contrast-row solved">
              <span class="contrast-tag maggo-tag">The Maggo Way</span>
              <p class="contrast-desc">
                Click Macintosh HD or any external SSD in the sidebar to immediately see exact gigabytes used, free space, and 1-click file browsing.
              </p>
            </div>
          </div>
        </div>
        <div class="showcase-media">
          <div class="mac-window-frame">
            <div class="frame-traffic-lights">
              <span class="t-light close"></span>
              <span class="t-light min"></span>
              <span class="t-light zoom"></span>
            </div>
            <img 
              src="/images/screenshots/maggo-storage.png" 
              alt="Maggo Storage Usage and Capacity Overview" 
              class="screenshot-img" 
              loading="lazy"
            />
          </div>
        </div>
      </div>

      <!-- Showcase 4: Smart Media & File Gallery -->
      <div class="showcase-card reversed">
        <div class="showcase-info">
          <span class="showcase-pill">Feature 04 • Smart Media</span>
          <h3 class="showcase-title">Visual filtering that actually makes sense.</h3>
          
          <!-- Finder vs Maggo Comparison Box -->
          <div class="contrast-box">
            <div class="contrast-row missing">
              <span class="contrast-tag finder-tag">Missing in Finder</span>
              <p class="contrast-desc">
                Building custom smart search queries requires 5+ clicks in Spotlight filters that reset every time you close the window.
              </p>
            </div>
            <div class="contrast-row solved">
              <span class="contrast-tag maggo-tag">The Maggo Way</span>
              <p class="contrast-desc">
                Instant 1-click filter pills (Recently Modified, Large &gt;5MB, Format picker) with high-density visual thumbnails and source directory badges.
              </p>
            </div>
          </div>
        </div>
        <div class="showcase-media">
          <div class="mac-window-frame">
            <div class="frame-traffic-lights">
              <span class="t-light close"></span>
              <span class="t-light min"></span>
              <span class="t-light zoom"></span>
            </div>
            <img 
              src="/images/screenshots/maggo-smart-pictures.png" 
              alt="Maggo Smart Pictures Gallery with Quick Filters" 
              class="screenshot-img" 
              loading="lazy"
            />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .features-section {
    background-color: #FFFFFF;
    position: relative;
  }

  .section-header-center {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 5rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .br-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .br-desktop {
      display: inline;
    }
  }

  .showcases-container {
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  .showcase-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-xl);
    padding: 3.5rem;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.2s var(--ease-apple), transform 0.2s var(--ease-apple);
  }

  .showcase-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  @media (min-width: 990px) {
    .showcase-card {
      grid-template-columns: 1fr 1.15fr;
      padding: 4rem;
    }

    .showcase-card.reversed {
      grid-template-columns: 1.15fr 1fr;
    }

    .showcase-card.reversed .showcase-info {
      order: 2;
    }

    .showcase-card.reversed .showcase-media {
      order: 1;
    }
  }

  @media (max-width: 640px) {
    .showcase-card {
      padding: 2rem 1.5rem;
      gap: 2rem;
    }
  }

  .showcase-info {
    display: flex;
    flex-direction: column;
  }

  .showcase-pill {
    align-self: flex-start;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    border: 1px solid var(--color-accent-border);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1.25rem;
  }

  .showcase-title {
    font-size: 1.85rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--color-text-main);
    margin-bottom: 2rem;
  }

  @media (max-width: 640px) {
    .showcase-title {
      font-size: 1.5rem;
    }
  }

  /* Contrast Box: Missing in Finder vs Maggo Solution */
  .contrast-box {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }

  .contrast-row {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contrast-row.missing {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border-light);
  }

  .contrast-tag {
    align-self: flex-start;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
  }

  .finder-tag {
    background: #FEF2F2;
    color: #991B1B;
    border: 1px solid #FECACA;
  }

  .maggo-tag {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    border: 1px solid var(--color-accent-border);
  }

  .contrast-desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--color-text-body);
  }

  .contrast-row.solved .contrast-desc {
    color: var(--color-text-main);
    font-weight: 500;
  }

  /* Screenshot Frame */
  .showcase-media {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .mac-window-frame {
    background: #FFFFFF;
    border-radius: 12px;
    box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    width: 100%;
    position: relative;
  }

  .frame-traffic-lights {
    display: flex;
    gap: 6px;
    padding: 10px 14px;
    background: #F1F5F9;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .t-light {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .t-light.close { background: #FF5F56; }
  .t-light.min { background: #FFBD2E; }
  .t-light.zoom { background: #27C93F; }

  .screenshot-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
</style>
