---
// FeaturesSection.astro
---

<section class="section-wrapper features-section" id="features">
  <div class="container">
    <div class="section-header-center">
      <div class="section-eyebrow">Built For The Way You Actually Work</div>
      <h2 class="section-title">
        Everything you need to manage files faster.
      </h2>
      <p class="section-subtitle">
        Simple, predictable tools engineered for speed. No bloat, no artificial complexity.
      </p>
    </div>

    <div class="features-grid">
      <!-- Feature 1: Clear navigation -->
      <div class="feature-card">
        <div class="feature-header">
          <div class="feature-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="3 11 22 2 13 21 11 13 3 11"/>
            </svg>
          </div>
          <span class="feature-number">01</span>
        </div>
        <h3 class="feature-title">Clear navigation</h3>
        <h4 class="feature-lead">Always know where you are.</h4>
        <p class="feature-desc">
          Breadcrumbs, a straightforward sidebar, Favorites, and clear folder hierarchy make navigating your Mac predictable.
        </p>
        <ul class="feature-bullets">
          <li>No wondering which folder you're in.</li>
          <li>No getting lost three levels deep.</li>
        </ul>
        <div class="feature-visual-bar">
          <span class="crumb-mini">Macintosh HD</span>
          <span>&rsaquo;</span>
          <span class="crumb-mini">Users</span>
          <span>&rsaquo;</span>
          <span class="crumb-mini active">Documents</span>
        </div>
      </div>

      <!-- Feature 2: Tabs -->
      <div class="feature-card">
        <div class="feature-header">
          <div class="feature-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <line x1="3" y1="9" x2="21" y2="9"/>
              <line x1="9" y1="21" x2="9" y2="9"/>
            </svg>
          </div>
          <span class="feature-number">02</span>
        </div>
        <h3 class="feature-title">Tabs</h3>
        <h4 class="feature-lead">Keep your folders in one window.</h4>
        <p class="feature-desc">
          Work across multiple locations without covering your desktop in Finder windows.
        </p>
        <div class="tabs-pill-demo">
          <span class="tab-chip active">Downloads</span>
          <span class="tab-chip">Projects</span>
          <span class="tab-chip">Documents</span>
        </div>
        <ul class="feature-bullets">
          <li>Open a tab (⌘T).</li>
          <li>Switch locations instantly.</li>
          <li>Keep working without clutter.</li>
        </ul>
      </div>

      <!-- Feature 3: Split view -->
      <div class="feature-card">
        <div class="feature-header">
          <div class="feature-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <line x1="12" y1="3" x2="12" y2="21"/>
            </svg>
          </div>
          <span class="feature-number">03</span>
        </div>
        <h3 class="feature-title">Split view</h3>
        <h4 class="feature-lead">See two places at once.</h4>
        <p class="feature-desc">
          Move files between folders without juggling windows. Drag and drop directly between panes.
        </p>
        <div class="split-mini-demo">
          <div class="mini-pane">
            <span class="pane-tag">Downloads</span>
            <code>invoice.pdf</code>
            <code>report.pdf</code>
            <code>photos/</code>
          </div>
          <div class="pane-transfer-arrow">&rarr;</div>
          <div class="mini-pane">
            <span class="pane-tag">Projects</span>
            <code>Finance/</code>
            <code>Documents/</code>
            <code>Assets/</code>
          </div>
        </div>
      </div>

      <!-- Feature 4: Move To (Featured Spotlight) -->
      <div class="feature-card feature-spotlight">
        <div class="spotlight-tag">Dedicated Workflow</div>
        <div class="feature-header">
          <div class="feature-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="12" y1="18" x2="12" y2="12"/>
              <line x1="9" y1="15" x2="15" y2="15"/>
            </svg>
          </div>
          <span class="feature-number">04</span>
        </div>
        <h3 class="feature-title">Move To… <span class="kbd-key">⌘⇧M</span></h3>
        <h4 class="feature-lead">Moving a file shouldn't require a scavenger hunt.</h4>
        <p class="feature-desc">
          No opening five folders just to get something where it belongs.
        </p>
        <div class="moveto-step-list">
          <div class="move-step">
            <span class="step-num">1</span>
            <span>Select a file.</span>
          </div>
          <div class="move-step">
            <span class="step-num">2</span>
            <span>Choose Move To (⌘⇧M).</span>
          </div>
          <div class="move-step">
            <span class="step-num">3</span>
            <span>Pick destination with fuzzy search.</span>
          </div>
          <div class="move-step done">
            <span class="step-num">✓</span>
            <span>Done.</span>
          </div>
        </div>
      </div>

      <!-- Feature 5: Search -->
      <div class="feature-card">
        <div class="feature-header">
          <div class="feature-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </div>
          <span class="feature-number">05</span>
        </div>
        <h3 class="feature-title">Search</h3>
        <h4 class="feature-lead">Find the file. Get on with your work.</h4>
        <p class="feature-desc">
          Search for files by name and quickly jump to the location you need. No complicated system to learn.
        </p>
        <div class="search-mini-bar">
          <span>🔍</span>
          <span class="search-sample">quarterly_statement.pdf</span>
          <span class="jump-pill">Jump &rarr;</span>
        </div>
        <ul class="feature-bullets">
          <li>Just search, select, open.</li>
          <li>Instant keystroke matching.</li>
        </ul>
      </div>

      <!-- Feature 6: Keyboard shortcuts -->
      <div class="feature-card">
        <div class="feature-header">
          <div class="feature-icon-box">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <line x1="6" y1="8" x2="6.01" y2="8"/>
              <line x1="10" y1="8" x2="10.01" y2="8"/>
              <line x1="14" y1="8" x2="14.01" y2="8"/>
              <line x1="18" y1="8" x2="18.01" y2="8"/>
              <line x1="6" y1="12" x2="6.01" y2="12"/>
              <line x1="10" y1="12" x2="10.01" y2="12"/>
              <line x1="14" y1="12" x2="14.01" y2="12"/>
              <line x1="18" y1="12" x2="18.01" y2="12"/>
              <line x1="8" y1="16" x2="16" y2="16"/>
            </svg>
          </div>
          <span class="feature-number">06</span>
        </div>
        <h3 class="feature-title">Keyboard shortcuts</h3>
        <h4 class="feature-lead">Your mouse doesn't need to do everything.</h4>
        <p class="feature-desc">
          The goal isn't to make you memorize shortcuts. It's to make them available when you want them.
        </p>
        <div class="shortcut-pills-list">
          <div class="shortcut-row">
            <span>New Tab</span>
            <span class="kbd-key">⌘T</span>
          </div>
          <div class="shortcut-row">
            <span>Split View</span>
            <span class="kbd-key">⌘⇧S</span>
          </div>
          <div class="shortcut-row">
            <span>Move To</span>
            <span class="kbd-key">⌘⇧M</span>
          </div>
          <div class="shortcut-row">
            <span>Copy Path</span>
            <span class="kbd-key">⌘⌥C</span>
          </div>
          <div class="shortcut-row">
            <span>Quick Look</span>
            <span class="kbd-key">Space</span>
          </div>
          <div class="shortcut-row">
            <span>Safe Undo</span>
            <span class="kbd-key">⌘Z</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .features-section {
    background-color: var(--color-bg);
  }

  .section-header-center {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3.5rem auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    position: relative;
  }

  .feature-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: #CBD5E1;
  }

  .feature-spotlight {
    border-color: rgba(136, 84, 208, 0.4);
    background: linear-gradient(180deg, #FFFFFF 0%, rgba(136, 84, 208, 0.04) 100%);
  }

  .spotlight-tag {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: #EBF5FF;
    color: var(--color-accent);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }

  .feature-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .feature-icon-box {
    width: 44px;
    height: 44px;
    background: #F1F5F9;
    color: var(--color-accent);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-number {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: #94A3B8;
  }

  .feature-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-main);
    letter-spacing: -0.02em;
    margin-bottom: 0.35rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .feature-lead {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .feature-desc {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .feature-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.8125rem;
    color: var(--color-text-body);
    margin-bottom: 1.25rem;
  }

  .feature-bullets li::before {
    content: "•";
    color: var(--color-accent);
    font-weight: bold;
    display: inline-block;
    width: 1em;
  }

  .feature-visual-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    padding: 0.4rem 0.65rem;
    border-radius: 6px;
    color: #64748B;
    margin-top: auto;
  }

  .crumb-mini.active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .tabs-pill-demo {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: #F1F5F9;
    padding: 0.35rem;
    border-radius: 6px;
    margin-bottom: 1rem;
  }

  .tab-chip {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    color: #64748B;
  }

  .tab-chip.active {
    background: #FFFFFF;
    color: #0F172A;
    font-weight: 600;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
  }

  .split-mini-demo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    margin-top: auto;
  }

  .mini-pane {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .pane-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .mini-pane code {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: #334155;
  }

  .pane-transfer-arrow {
    font-size: 1.25rem;
    color: var(--color-accent);
    font-weight: bold;
  }

  .moveto-step-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: auto;
  }

  .move-step {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.8125rem;
    color: var(--color-text-body);
  }

  .step-num {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #EBF5FF;
    color: var(--color-accent);
    font-size: 0.6875rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .move-step.done .step-num {
    background: #DCFCE7;
    color: #15803D;
  }

  .search-mini-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    font-size: 0.75rem;
    margin-bottom: 1rem;
  }

  .search-sample {
    font-family: var(--font-mono);
    color: var(--color-text-main);
    flex: 1;
  }

  .jump-pill {
    background: #E2E8F0;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-weight: 600;
    color: var(--color-text-body);
  }

  .shortcut-pills-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-top: auto;
  }

  .shortcut-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    padding: 0.35rem 0.65rem;
    border-radius: 6px;
    font-size: 0.75rem;
    color: var(--color-text-body);
  }
</style>
