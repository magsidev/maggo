---
// FaqSection.astro

const faqs = [
  {
    q: "What is Maggo?",
    a: "Maggo is a file manager for Mac designed to make navigating, finding, moving, copying, and organizing files easier."
  },
  {
    q: "Is Maggo a replacement for Finder?",
    a: "Maggo can be used as an alternative to Finder for everyday file management. You can also use Maggo alongside Finder."
  },
  {
    q: "How much does Maggo cost?",
    a: "Maggo costs $19.99 as a one-time purchase for a permanent lifetime license. You can start with a 3-day free trial with $0 charged today. On day 3, your card is automatically charged the $19.99 one-time fee unless cancelled."
  },
  {
    q: "How does the 3-day free trial work?",
    a: "You get full, unrestricted access to Maggo immediately. You enter your card details at checkout, and $0 is charged today. On the third day, your card is automatically charged $19.99 for permanent lifetime ownership and support. You can cancel anytime before day 3 with zero charge."
  },
  {
    q: "Does Maggo require an account?",
    a: "No. The core application does not require an account."
  },
  {
    q: "Does Maggo use AI?",
    a: "No. Maggo is intentionally designed without AI. Its focus is fast, predictable file management."
  },
  {
    q: "Does Maggo work with external drives?",
    a: "Yes. Maggo is designed to work with files and folders stored on your Mac and supported external storage."
  },
  {
    q: "Can I use keyboard shortcuts?",
    a: "Yes. Maggo is designed with keyboard-friendly file management in mind."
  },
  {
    q: "Does Maggo replace Finder?",
    a: "Maggo is an alternative file manager. Finder remains available on your Mac, and you can use both applications."
  },
  {
    q: "Is Maggo a file organizer?",
    a: "Maggo helps you navigate and manage your files, including moving, copying, renaming, and organizing them into folders."
  }
];
---

<section class="section-wrapper faq-section" id="faq">
  <div class="container">
    <div class="section-header-center">
      <div class="section-eyebrow">Clear Answers</div>
      <h2 class="section-title">
        Frequently asked questions.
      </h2>
      <p class="section-subtitle">
        Everything you need to know about Maggo, purchasing, and macOS compatibility.
      </p>
    </div>

    <div class="faq-list">
      {faqs.map((faq, index) => (
        <details class="faq-item" open={index === 0}>
          <summary class="faq-question">
            <span>{faq.q}</span>
            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div class="faq-answer">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>

    <div class="faq-footer-help">
      <span>Have another question?</span>
      <a href="mailto:support@maggo.app" class="faq-contact-link">Contact developer support &rarr;</a>
    </div>
  </div>
</section>

<!-- JSON-LD FAQ Schema for Google Rich Search Results -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
})} />

<style>
  .faq-section {
    background-color: var(--color-bg-subtle);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .section-header-center {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 3rem auto;
  }

  .faq-list {
    max-width: 760px;
    margin: 0 auto 3rem auto;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .faq-item {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .faq-item[open] {
    border-color: #CBD5E1;
    box-shadow: var(--shadow-sm);
  }

  .faq-question {
    list-style: none;
    padding: 1.25rem 1.5rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text-main);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    color: var(--color-text-muted);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--color-accent);
  }

  .faq-answer {
    padding: 0 1.5rem 1.25rem 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-body);
  }

  .faq-footer-help {
    text-align: center;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .faq-contact-link {
    color: var(--color-accent);
    font-weight: 600;
  }

  .faq-contact-link:hover {
    text-decoration: underline;
  }
</style>
