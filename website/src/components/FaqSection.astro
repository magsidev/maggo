---
// FaqSection.astro

const faqs = [
  {
    q: "What is Maggo?",
    a: "Maggo is a dedicated file manager for Mac designed to make navigating, finding, moving, copying, and organizing files simpler and faster."
  },
  {
    q: "How does the 3-day trial and lifetime license work?",
    a: "You get unrestricted access to Maggo for 3 full days. You enter card details securely at checkout, and $0 is charged today. On day 3, your card is automatically charged the one-time $19.99 fee for permanent lifetime ownership. You can cancel anytime before day 3 with zero charge."
  },
  {
    q: "Is Maggo a subscription or a one-time purchase?",
    a: "Maggo is 100% one-time purchase. There are no monthly or yearly subscriptions. Once purchased, you own it permanently with all macOS compatibility updates included."
  },
  {
    q: "Does Maggo replace Finder or can I use both?",
    a: "Maggo works independently alongside macOS. Finder remains intact on your system, and you can switch between them or use Maggo as your default daily file organizer."
  },
  {
    q: "Does Maggo use AI or upload my files to the cloud?",
    a: "No. Maggo is intentionally built with zero AI features, zero telemetry, and zero cloud uploads. Your files never leave your local Mac storage."
  },
  {
    q: "Does Maggo work with external SSDs, USB drives, and network volumes?",
    a: "Yes. All internal drives, external SSDs, SD cards, and mounted network storage appear directly in the sidebar with live storage gauges."
  },
  {
    q: "Can I use Maggo on multiple Macs?",
    a: "Each $19.99 lifetime license is valid for 1 active Mac. If you switch or upgrade to a new Mac, you can easily transfer your license to your new device."
  },
  {
    q: "What are the system requirements?",
    a: "Maggo runs natively on Apple Silicon (M1/M2/M3/M4) and Intel Macs running macOS 13.0 Ventura, macOS 14.0 Sonoma, macOS 15.0 Sequoia, or later."
  }
];
---

<section class="section-wrapper faq-section" id="faq">
  <div class="container">
    <div class="section-header-center">
      <div class="section-eyebrow">Clear Answers</div>
      <h2 class="section-title">
        Frequently asked questions.
      </h2>
      <p class="section-subtitle">
        Everything you need to know about Maggo, purchasing, and macOS compatibility.
      </p>
    </div>

    <div class="faq-list">
      {faqs.map((faq, index) => (
        <details class="faq-item" open={index === 0}>
          <summary class="faq-question">
            <span>{faq.q}</span>
            <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div class="faq-answer">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>

    <div class="faq-footer-help">
      <span>Have another question?</span>
      <a href="mailto:support@maggo.app" class="faq-contact-link">Contact developer support &rarr;</a>
    </div>
  </div>
</section>

<!-- JSON-LD FAQ Schema for Search Engines -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
})} />

<style>
  .faq-section {
    background-color: var(--color-bg-subtle);
    border-top: 1px solid var(--color-border-light);
    border-bottom: 1px solid var(--color-border-light);
  }

  .section-header-center {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 4rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .faq-list {
    max-width: 760px;
    margin: 0 auto 3rem auto;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .faq-item {
    background: #FFFFFF;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color 0.2s var(--ease-apple), box-shadow 0.2s var(--ease-apple);
  }

  .faq-item[open] {
    border-color: rgba(136, 84, 208, 0.3);
    box-shadow: var(--shadow-sm);
  }

  .faq-question {
    list-style: none;
    padding: 1.35rem 1.75rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text-main);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    user-select: none;
    letter-spacing: -0.015em;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    color: #94A3B8;
    transition: transform 0.2s var(--ease-apple), color 0.2s var(--ease-apple);
    flex-shrink: 0;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--color-accent);
  }

  .faq-answer {
    padding: 0 1.75rem 1.35rem 1.75rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    border-top: 1px solid rgba(0, 0, 0, 0.04);
    padding-top: 0.85rem;
  }

  .faq-footer-help {
    text-align: center;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .faq-contact-link {
    color: var(--color-accent);
    font-weight: 600;
    transition: opacity 0.15s ease;
  }

  .faq-contact-link:hover {
    text-decoration: underline;
  }
</style>
