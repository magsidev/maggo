---
// FinalCta.astro
---

<section class="section-wrapper final-cta-section">
  <div class="container">
    <div class="cta-banner-card">
      <div class="cta-content">
        <div class="cta-logo-wrap">
          <img src="/images/maggo-logo.png" alt="Maggo Logo" width="64" height="64" class="cta-logo-img" />
        </div>
        <span class="cta-badge">A Better, Simpler File Manager</span>
        <h2 class="cta-headline">
          Managing files on Mac <br class="br-desktop" />
          <span class="accent-serif">feels simple again.</span>
        </h2>
        <p class="cta-subhead">
          Join Mac users who replaced window clutter with fast, predictable, one-window file organization.
        </p>

        <div class="cta-actions">
          <a href="/downloads/Maggo-macOS.dmg" download class="btn btn-primary btn-lg cta-btn">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
              <path d="M16.4 12.7c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9s-2-.9-3.3-.8c-1.7 0-3.3 1-4.1 2.5-1.8 3.1-.5 7.6 1.3 10.1.9 1.2 1.9 2.6 3.2 2.5 1.3 0 1.8-.8 3.3-.8s2 .8 3.3.8 2.2-1.2 3.1-2.4c1-1.4 1.4-2.7 1.4-2.8-.1 0-2.7-1-2.7-4.1zM14 5.3c.7-.8 1.2-2 1-3.3-1 0-2.3.7-3 1.5-.7.8-1.2 2-1 3.2 1.1 0 2.3-.6 3-1.4z"/>
            </svg>
            <span>Download for Mac — Free</span>
          </a>
          <a href="#features" class="btn btn-secondary btn-lg cta-secondary-btn">
            <span>Explore All Features</span>
          </a>
        </div>

        <div class="cta-footer-note">
          <span>100% Free • macOS 14.0 Sonoma or later • Zero telemetry</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    background-color: var(--color-bg);
  }

  .cta-banner-card {
    background: radial-gradient(circle at 50% 0%, rgba(136, 84, 208, 0.3), transparent 75%), linear-gradient(180deg, #0F172A 0%, #150E24 100%);
    border-radius: var(--radius-xl);
    padding: 5rem 2.5rem;
    color: #FFFFFF;
    text-align: center;
    box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.4), 0 0 0 1px rgba(136, 84, 208, 0.25);
    position: relative;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .cta-banner-card {
      padding: 3.5rem 1.5rem;
    }
  }

  .cta-content {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .br-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .br-desktop {
      display: inline;
    }
  }

  .cta-logo-wrap {
    margin-bottom: 1.5rem;
  }

  .cta-logo-img {
    border-radius: 16px;
    box-shadow: 0 12px 30px -5px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.2);
    display: block;
  }

  .cta-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(136, 84, 208, 0.25);
    color: #DDD6FE;
    border: 1px solid rgba(136, 84, 208, 0.4);
    padding: 0.25rem 0.85rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1.5rem;
  }

  .cta-headline {
    font-size: 2.75rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.035em;
    margin-bottom: 1.15rem;
  }

  @media (min-width: 768px) {
    .cta-headline {
      font-size: 3.5rem;
    }
  }

  .cta-subhead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: #CBD5E1;
    margin-bottom: 1.75rem;
    max-width: 620px;
  }

  .cta-pricing-line {
    font-size: 1.05rem;
    color: #94A3B8;
    margin-bottom: 2.25rem;
  }

  .cta-pricing-line strong {
    color: #FFFFFF;
    font-size: 1.2rem;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }

  .cta-btn {
    box-shadow: 0 4px 25px rgba(136, 84, 208, 0.5);
  }

  .cta-secondary-btn {
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .cta-secondary-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
  }

  .cta-footer-note {
    font-size: 0.8125rem;
    color: #94A3B8;
  }
</style>
