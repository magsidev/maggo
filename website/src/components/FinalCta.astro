---
// FinalCta.astro
---

<section class="section-wrapper final-cta-section">
  <div class="container">
    <div class="cta-banner-card">
      <div class="cta-content">
        <span class="cta-badge">Ready for a Better Finder?</span>
        <p class="cta-headline">
          File management that finally feels simple.
        </p>
        <p class="cta-subhead">
          Join thousands of Mac users who replaced window clutter with fast, predictable, one-window file organization.
        </p>

        <div class="cta-pricing-line">
          <strong>3-Day Free Trial ($0 Today).</strong> Then $19.99 once on day 3 for lifetime access.
        </div>

        <div class="cta-actions">
          <a href="https://checkout.maggo.app" target="_blank" rel="noopener" class="btn btn-primary btn-lg cta-btn">
            <span>Start 3-Day Free Trial</span>
          </a>
          <a href="#pricing" class="btn btn-secondary btn-lg">
            <span>View Pricing &amp; Terms</span>
          </a>
        </div>

        <div class="cta-footer-note">
          <span>Card entered at checkout with $0 charged today. Auto-renews to $19.99 once on day 3. Cancel anytime.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    background-color: var(--color-bg);
  }

  .cta-banner-card {
    background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
    border-radius: var(--radius-xl);
    padding: 4rem 2.5rem;
    color: #FFFFFF;
    text-align: center;
    box-shadow: var(--shadow-lg);
    position: relative;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .cta-banner-card {
      padding: 3rem 1.5rem;
    }
  }

  .cta-content {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(10, 132, 255, 0.2);
    color: #60A5FA;
    border: 1px solid rgba(10, 132, 255, 0.4);
    padding: 0.25rem 0.85rem;
    border-radius: 9999px;
    margin-bottom: 1.25rem;
  }

  .cta-headline {
    font-size: 2.5rem;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .cta-headline {
      font-size: 3.25rem;
    }
  }

  .cta-subhead {
    font-size: 1.125rem;
    line-height: 1.6;
    color: #CBD5E1;
    margin-bottom: 1.5rem;
  }

  .cta-pricing-line {
    font-size: 1.0625rem;
    color: #94A3B8;
    margin-bottom: 2rem;
  }

  .cta-pricing-line strong {
    color: #FFFFFF;
    font-size: 1.25rem;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .cta-btn {
    box-shadow: 0 4px 20px rgba(10, 132, 255, 0.5);
  }

  .cta-footer-note {
    font-size: 0.8125rem;
    color: #94A3B8;
  }
</style>
