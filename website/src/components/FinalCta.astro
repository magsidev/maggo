---
// FinalCta.astro
---

<section class="section-wrapper final-cta-section">
  <div class="container">
    <div class="cta-banner-card">
      <div class="cta-content">
        <div class="cta-logo-wrap">
          <img src="/images/maggo-logo.png" alt="Maggo Logo" width="64" height="64" class="cta-logo-img" />
        </div>
        <span class="cta-badge">A Better, Simpler File Manager</span>
        <h2 class="cta-headline">
          Managing files on Mac <br class="br-desktop" />feels simple again.
        </h2>
        <p class="cta-subhead">
          Join Mac users who replaced window clutter with fast, predictable, one-window file organization.
        </p>

        <div class="cta-pricing-line">
          <strong>3-Day Free Trial ($0 Today).</strong> Then $19.99 once on day 3 for lifetime ownership.
        </div>

        <div class="cta-actions">
          <a href="https://checkout.maggo.app" target="_blank" rel="noopener" class="btn btn-primary btn-lg cta-btn">
            <span>Start 3-Day Free Trial</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="#pricing" class="btn btn-secondary btn-lg cta-secondary-btn">
            <span>View Pricing &amp; Terms</span>
          </a>
        </div>

        <div class="cta-footer-note">
          <span>Card entered at checkout with $0 charged today • Auto-renews to $19.99 lifetime on day 3 • Cancel anytime</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    background-color: var(--color-bg);
  }

  .cta-banner-card {
    background: radial-gradient(circle at 50% 0%, rgba(136, 84, 208, 0.3), transparent 75%), linear-gradient(180deg, #0F172A 0%, #150E24 100%);
    border-radius: var(--radius-xl);
    padding: 5rem 2.5rem;
    color: #FFFFFF;
    text-align: center;
    box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.4), 0 0 0 1px rgba(136, 84, 208, 0.25);
    position: relative;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .cta-banner-card {
      padding: 3.5rem 1.5rem;
    }
  }

  .cta-content {
    max-width: 760px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .br-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .br-desktop {
      display: inline;
    }
  }

  .cta-logo-wrap {
    margin-bottom: 1.5rem;
  }

  .cta-logo-img {
    border-radius: 16px;
    box-shadow: 0 12px 30px -5px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.2);
    display: block;
  }

  .cta-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(136, 84, 208, 0.25);
    color: #DDD6FE;
    border: 1px solid rgba(136, 84, 208, 0.4);
    padding: 0.25rem 0.85rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1.5rem;
  }

  .cta-headline {
    font-size: 2.75rem;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.035em;
    margin-bottom: 1.15rem;
  }

  @media (min-width: 768px) {
    .cta-headline {
      font-size: 3.5rem;
    }
  }

  .cta-subhead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: #CBD5E1;
    margin-bottom: 1.75rem;
    max-width: 620px;
  }

  .cta-pricing-line {
    font-size: 1.05rem;
    color: #94A3B8;
    margin-bottom: 2.25rem;
  }

  .cta-pricing-line strong {
    color: #FFFFFF;
    font-size: 1.2rem;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }

  .cta-btn {
    box-shadow: 0 4px 25px rgba(136, 84, 208, 0.5);
  }

  .cta-secondary-btn {
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .cta-secondary-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
  }

  .cta-footer-note {
    font-size: 0.8125rem;
    color: #94A3B8;
  }
</style>
