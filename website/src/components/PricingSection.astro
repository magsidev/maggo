---
// PricingSection.astro
---

<section class="section-wrapper pricing-section" id="download">
  <div class="container">
    <div class="section-header-center">
      <div class="section-eyebrow">Get Started in Seconds</div>
      <h2 class="section-title">
        100% Free. <br class="br-desktop" />
        <span class="accent-serif">No subscriptions. No paywalls.</span>
      </h2>
      <p class="section-subtitle">
        Download Maggo free for your Mac. Complete access to every tool, zero telemetry, and permanent offline privacy.
      </p>
    </div>

    <!-- Free Download Card -->
    <div class="pricing-card-container">
      <div class="pricing-main-card">
        <div class="pricing-badge-corner">100% FREE FOR MACOS</div>

        <div class="pricing-header">
          <span class="pricing-plan-title">Maggo for Mac</span>
          <p class="pricing-plan-desc">Fast, calm, and distraction-free file management.</p>
        </div>

        <div class="pricing-figure-block">
          <div class="figure-wrap">
            <span class="currency-symbol">$</span>
            <span class="price-value">0</span>
            <span class="price-suffix">forever</span>
          </div>
          <div class="figure-meta">
            <span class="payment-type">Free Community Edition</span>
            <span class="no-recur-pill">Zero Subscriptions</span>
          </div>
        </div>

        <div class="pricing-divider"></div>

        <ul class="pricing-features-list">
          <li>
            <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span><strong>Full unrestricted access</strong> to all file tools</span>
          </li>
          <li>
            <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span><strong>Dual-Pane Split View &amp; Multi-Tabs</strong> (<span class="kbd-key">⌘⇧S</span> / <span class="kbd-key">⌘T</span>)</span>
          </li>
          <li>
            <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span><strong>Direct Move To &amp; Copy To</strong> (<span class="kbd-key">⌘⇧M</span>) with fuzzy search</span>
          </li>
          <li>
            <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span><strong>Drive Storage Gauges &amp; Smart Media Gallery</strong></span>
          </li>
          <li>
            <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span><strong>100% Offline &amp; Private</strong> — zero telemetry, zero cloud tracking</span>
          </li>
          <li>
            <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span><strong>Native Swift 6 &amp; SwiftUI</strong> on Apple Silicon &amp; Intel</span>
          </li>
        </ul>

        <div class="pricing-actions-wrap">
          <a href="/downloads/Maggo-macOS.dmg" download class="btn btn-primary btn-lg pricing-cta-btn">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
              <path d="M16.4 12.7c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9s-2-.9-3.3-.8c-1.7 0-3.3 1-4.1 2.5-1.8 3.1-.5 7.6 1.3 10.1.9 1.2 1.9 2.6 3.2 2.5 1.3 0 1.8-.8 3.3-.8s2 .8 3.3.8 2.2-1.2 3.1-2.4c1-1.4 1.4-2.7 1.4-2.8-.1 0-2.7-1-2.7-4.1zM14 5.3c.7-.8 1.2-2 1-3.3-1 0-2.3.7-3 1.5-.7.8-1.2 2-1 3.2 1.1 0 2.3-.6 3-1.4z"/>
            </svg>
            <span>Download Maggo (.dmg) — Free</span>
          </a>
          <a href="/downloads/Maggo-macOS.zip" download class="alt-zip-link">
            <span>Prefer .zip archive? Download Maggo.zip &rarr;</span>
          </a>
          <span class="card-terms-note">macOS 14.0 Sonoma or macOS 15.0 Sequoia required</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    background-color: #FFFFFF;
  }

  .section-header-center {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 4rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pricing-card-container {
    max-width: 680px;
    margin: 0 auto;
  }

  .pricing-main-card {
    background: #FFFFFF;
    border: 1px solid rgba(136, 84, 208, 0.35);
    border-radius: var(--radius-xl);
    padding: 3.5rem 3rem;
    box-shadow: 0 20px 50px -10px rgba(136, 84, 208, 0.12), 0 0 0 1px rgba(136, 84, 208, 0.2);
    position: relative;
    text-align: center;
  }

  @media (max-width: 640px) {
    .pricing-main-card {
      padding: 2.5rem 1.5rem;
    }
  }

  .pricing-badge-corner {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-accent);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.3rem 1.25rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 12px rgba(136, 84, 208, 0.4);
    white-space: nowrap;
  }

  .pricing-header {
    margin-bottom: 1.5rem;
  }

  .pricing-plan-title {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-text-main);
    display: block;
    margin-bottom: 0.35rem;
  }

  .pricing-plan-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .pricing-figure-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 2rem;
  }

  .figure-wrap {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    line-height: 1;
  }

  .currency-symbol {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-top: 0.5rem;
    margin-right: 0.2rem;
  }

  .price-value {
    font-size: 5rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    color: var(--color-text-main);
  }

  .price-suffix {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-muted);
    align-self: flex-end;
    margin-bottom: 0.85rem;
    margin-left: 0.35rem;
  }

  .figure-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .payment-type {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-body);
  }

  .no-recur-pill {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: #ECFDF5;
    color: #065F46;
    border: 1px solid #A7F3D0;
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-pill);
  }

  .pricing-divider {
    height: 1px;
    background: var(--color-border);
    margin-bottom: 2rem;
  }

  .pricing-features-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
    text-align: left;
    margin-bottom: 2.5rem;
  }

  .pricing-features-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--color-text-body);
  }

  .check-icon {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .pricing-actions-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .pricing-cta-btn {
    width: 100%;
    padding: 1rem;
    font-size: 1.05rem;
    box-shadow: 0 14px 40px -10px rgba(136, 84, 208, 0.6);
  }

  .alt-zip-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    margin-top: 0.25rem;
    transition: opacity 0.15s ease;
  }

  .alt-zip-link:hover {
    opacity: 0.8;
  }

  .card-terms-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .purchasing-flow-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-body);
    flex-wrap: wrap;
  }

  .flow-step {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .step-badge {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #FFFFFF;
    font-size: 0.6875rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .flow-arrow {
    color: #94A3B8;
  }
</style>
