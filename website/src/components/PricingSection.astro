---
// PricingSection.astro
---

<section class="section-wrapper pricing-section" id="pricing">
  <div class="container">
    <div class="section-header-center">
      <div class="section-eyebrow">Honest, Upfront Pricing</div>
      <h2 class="section-title">
        One payment. Lifetime ownership.
      </h2>
      <p class="section-subtitle">
        Try Maggo free for 3 days with $0 charged today. Keep it for a single payment of $19.99 with lifetime updates and zero recurring fees.
      </p>
    </div>

    <!-- Prominent Pricing Box -->
    <div class="pricing-card-container">
      <div class="pricing-main-card">
        <div class="pricing-badge-corner">3-DAY FREE TRIAL • $19.99 LIFETIME</div>

        <div class="pricing-header">
          <span class="pricing-plan-title">Maggo for Mac</span>
          <p class="pricing-plan-desc">Experience the full app for 3 days. Unlock lifetime ownership on day 3.</p>
        </div>

        <div class="pricing-figure-block">
          <div class="figure-wrap">
            <span class="currency-symbol">$</span>
            <span class="price-value">0</span>
            <span class="price-suffix">today</span>
          </div>
          <div class="figure-meta">
            <span class="payment-type">Then $19.99 once on Day 3</span>
            <span class="no-recur-pill">Zero Subscriptions</span>
          </div>
        </div>

        <div class="pricing-divider"></div>

        <ul class="pricing-features-list">
          <li>
            <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span><strong>3-day unrestricted access</strong> to all features</span>
          </li>
          <li>
            <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span><strong>$0 charged today</strong> (card verified at checkout)</span>
          </li>
          <li>
            <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span><strong>Automatic activation</strong> of $19.99 lifetime license on Day 3</span>
          </li>
          <li>
            <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span><strong>1-Click cancellation</strong> anytime before Day 3 if it's not for you</span>
          </li>
          <li>
            <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span><strong>All future macOS updates included</strong> — never pay again</span>
          </li>
          <li>
            <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span><strong>1 Mac lifetime license</strong> with easy device transfer</span>
          </li>
        </ul>

        <div class="pricing-actions-wrap">
          <a href="https://checkout.maggo.app" target="_blank" rel="noopener" class="btn btn-primary btn-lg pricing-cta-btn">
            <span>Start 3-Day Free Trial — $0 Today</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <span class="card-terms-note">Secure 256-bit SSL checkout • Auto-renews to $19.99 on day 3 • Cancel anytime</span>
        </div>

        <!-- 3-Day Trial Flow Step Indicators -->
        <div class="purchasing-flow-bar">
          <div class="flow-step">
            <span class="step-badge">1</span>
            <span>Card entered ($0)</span>
          </div>
          <span class="flow-arrow">&rarr;</span>
          <div class="flow-step">
            <span class="step-badge">2</span>
            <span>3 Days Full Access</span>
          </div>
          <span class="flow-arrow">&rarr;</span>
          <div class="flow-step">
            <span class="step-badge">3</span>
            <span>$19.99 Lifetime Access</span>
          </div>
        </div>
      </div>

      <!-- 1-Line Web Installer Box for Power Users & Developers -->
      <div class="terminal-installer-card">
        <div class="terminal-header">
          <div class="terminal-dots">
            <span class="t-dot red"></span>
            <span class="t-dot yellow"></span>
            <span class="t-dot green"></span>
          </div>
          <span class="terminal-title">Terminal Direct 1-Line Installer</span>
        </div>
        <div class="terminal-body">
          <code class="terminal-code" id="curlCmd">/bin/bash -c "$(curl -fsSL https://maggo.app/install.sh)"</code>
          <button class="copy-cmd-btn" id="copyCmdBtn" title="Copy to clipboard">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <span id="copyBtnText">Copy</span>
          </button>
        </div>
        <span class="terminal-subtext">
          Directly verifies and installs the native app bundle into <code>/Applications</code>.
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    background-color: #FFFFFF;
  }

  .section-header-center {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 4rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .pricing-card-container {
    max-width: 680px;
    margin: 0 auto;
  }

  .pricing-main-card {
    background: #FFFFFF;
    border: 1px solid rgba(136, 84, 208, 0.35);
    border-radius: var(--radius-xl);
    padding: 3.5rem 3rem;
    box-shadow: 0 20px 50px -10px rgba(136, 84, 208, 0.12), 0 0 0 1px rgba(136, 84, 208, 0.2);
    position: relative;
    text-align: center;
  }

  @media (max-width: 640px) {
    .pricing-main-card {
      padding: 2.5rem 1.5rem;
    }
  }

  .pricing-badge-corner {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-accent);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.3rem 1.25rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 12px rgba(136, 84, 208, 0.4);
    white-space: nowrap;
  }

  .pricing-header {
    margin-bottom: 1.5rem;
  }

  .pricing-plan-title {
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--color-text-main);
    display: block;
    margin-bottom: 0.35rem;
  }

  .pricing-plan-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .pricing-figure-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 2rem;
  }

  .figure-wrap {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    line-height: 1;
  }

  .currency-symbol {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin-top: 0.5rem;
    margin-right: 0.2rem;
  }

  .price-value {
    font-size: 5rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    color: var(--color-text-main);
  }

  .price-suffix {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-muted);
    align-self: flex-end;
    margin-bottom: 0.85rem;
    margin-left: 0.35rem;
  }

  .figure-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .payment-type {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-body);
  }

  .no-recur-pill {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: #ECFDF5;
    color: #065F46;
    border: 1px solid #A7F3D0;
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-pill);
  }

  .pricing-divider {
    height: 1px;
    background: var(--color-border);
    margin-bottom: 2rem;
  }

  .pricing-features-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
    text-align: left;
    margin-bottom: 2.5rem;
  }

  .pricing-features-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    color: var(--color-text-body);
  }

  .check-icon {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .pricing-actions-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .pricing-cta-btn {
    width: 100%;
    padding: 1rem;
    font-size: 1.05rem;
    box-shadow: 0 4px 20px rgba(136, 84, 208, 0.4);
  }

  .card-terms-note {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .purchasing-flow-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-body);
    flex-wrap: wrap;
  }

  .flow-step {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .step-badge {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #FFFFFF;
    font-size: 0.6875rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .flow-arrow {
    color: #94A3B8;
  }

  /* Terminal Installer */
  .terminal-installer-card {
    background: #0B0F19;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow-md);
    margin-top: 2rem;
    overflow: hidden;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
  }

  .t-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .t-dot.red { background: #FF5F56; }
  .t-dot.yellow { background: #FFBD2E; }
  .t-dot.green { background: #27C93F; }

  .terminal-title {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: #94A3B8;
  }

  .terminal-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    gap: 1rem;
  }

  .terminal-code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: #38BDF8;
    overflow-x: auto;
    white-space: nowrap;
  }

  .copy-cmd-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #FFFFFF;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.18);
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .copy-cmd-btn:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .terminal-subtext {
    display: block;
    font-size: 0.75rem;
    color: #64748B;
    padding: 0 1.25rem 0.85rem 1.25rem;
  }

  .terminal-subtext code {
    font-family: var(--font-mono);
    color: #94A3B8;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const copyCmdBtn = document.getElementById('copyCmdBtn');
    const curlCmd = document.getElementById('curlCmd');
    const copyBtnText = document.getElementById('copyBtnText');

    if (copyCmdBtn && curlCmd && copyBtnText) {
      copyCmdBtn.addEventListener('click', () => {
        const text = curlCmd.textContent || '';
        navigator.clipboard.writeText(text).then(() => {
          copyBtnText.textContent = 'Copied!';
          setTimeout(() => {
            copyBtnText.textContent = 'Copy';
          }, 2000);
        });
      });
    }
  });
</script>
