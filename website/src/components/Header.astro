---
// Header.astro
---

<header class="site-header">
  <nav class="nav-container container">
    <a href="/" class="brand" aria-label="Maggo Home">
      <div class="brand-icon">
        <img src="/images/maggo-logo.png" alt="Maggo App Icon" class="brand-logo-img" width="32" height="32" />
      </div>
      <span class="brand-name">Maggo</span>
    </a>

    <div class="nav-links">
      <a href="#features" class="nav-link">Overview</a>
      <a href="#demo" class="nav-link">Interactive Demo</a>
      <a href="#familiar" class="nav-link">Native Design</a>
      <a href="#comparison" class="nav-link">Why Maggo</a>
      <a href="#pricing" class="nav-link">Pricing</a>
      <a href="#faq" class="nav-link">FAQ</a>
    </div>

    <div class="nav-actions">
      <a href="#pricing" class="btn btn-primary nav-buy-btn">
        <span>Try Free for 3 Days</span>
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
    transition: background 0.3s ease;
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--color-text-main);
    letter-spacing: -0.025em;
  }

  .brand-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    overflow: hidden;
  }

  .brand-logo-img {
    display: block;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  }

  .brand-name {
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-text-main);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-buy-btn {
    font-size: 0.84rem;
    font-weight: 600;
    padding: 0.5rem 1.15rem;
    border-radius: var(--radius-pill);
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
  }
</style>
