---
// Header.astro
---

<header class="header-floating-wrapper">
  <nav class="floating-nav-pill">
    <a href="/" class="brand-pill" aria-label="Maggo Home">
      <img src={`${import.meta.env.BASE_URL}/images/maggo-logo.png`} alt="Maggo Logo" class="nav-logo" width="28" height="28" />
      <span class="nav-title">Maggo</span>
    </a>

    <div class="nav-menu-links">
      <a href="#features" class="menu-link">Features</a>
      <a href="#comparison" class="menu-link">Why Maggo</a>
      <a href="#download" class="menu-link">Download</a>
      <a href="#faq" class="menu-link">FAQ</a>
    </div>

    <div class="nav-right-action">
      <a href={`${import.meta.env.BASE_URL}/downloads/Maggo-macOS.dmg`} download class="btn btn-primary nav-cta-pill">
        <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
          <path d="M16.4 12.7c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9s-2-.9-3.3-.8c-1.7 0-3.3 1-4.1 2.5-1.8 3.1-.5 7.6 1.3 10.1.9 1.2 1.9 2.6 3.2 2.5 1.3 0 1.8-.8 3.3-.8s2 .8 3.3.8 2.2-1.2 3.1-2.4c1-1.4 1.4-2.7 1.4-2.8-.1 0-2.7-1-2.7-4.1zM14 5.3c.7-.8 1.2-2 1-3.3-1 0-2.3.7-3 1.5-.7.8-1.2 2-1 3.2 1.1 0 2.3-.6 3-1.4z"/>
        </svg>
        <span>Download Free</span>
      </a>
    </div>
  </nav>
</header>

<style>
  .header-floating-wrapper {
    position: fixed;
    top: 1rem;
    left: 0;
    right: 0;
    z-index: 999;
    display: flex;
    justify-content: center;
    padding: 0 1rem;
    pointer-events: none;
  }

  .floating-nav-pill {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 780px;
    background: rgba(15, 16, 21, 0.9);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-pill);
    padding: 0.45rem 0.6rem 0.45rem 1rem;
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.35);
  }

  .brand-pill {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .nav-logo {
    border-radius: 7px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
    display: block;
  }

  .nav-title {
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #FFFFFF;
  }

  .nav-menu-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .menu-link {
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.68);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .menu-link:hover {
    color: #FFFFFF;
    background-color: rgba(255, 255, 255, 0.08);
  }

  .nav-cta-pill {
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.48rem 1.15rem;
    border-radius: var(--radius-pill);
    gap: 0.4rem;
  }

  @media (max-width: 640px) {
    .nav-menu-links {
      display: none;
    }
  }
</style>
