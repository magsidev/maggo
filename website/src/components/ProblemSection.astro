---
// ProblemSection.astro
---

<section class="section-wrapper problem-section" id="problem">
  <div class="container">
    <div class="problem-content-block">
      <div class="section-eyebrow">The Problem</div>
      <h2 class="section-title">
        Your files shouldn't feel harder to manage than they are.
      </h2>

      <div class="lead-paragraphs">
        <p class="lead-text">
          You already know where you want a file to go.
        </p>
        <p class="lead-text">
          But getting there can mean opening windows, digging through folders, dragging files around, and losing track of where you are.
        </p>
      </div>

      <div class="philosophy-card">
        <div class="philosophy-icon">💡</div>
        <div class="philosophy-text">
          <span class="philosophy-header">Maggo is designed around a simpler idea:</span>
          <p class="philosophy-quote">
            You should spend your time working with your files — not working around your file manager.
          </p>
          <div class="three-steps">
            <span class="step-pill">Find the folder</span>
            <span class="step-arrow">&rarr;</span>
            <span class="step-pill">Select the files</span>
            <span class="step-arrow">&rarr;</span>
            <span class="step-pill">Move them</span>
            <span class="step-arrow">&rarr;</span>
            <span class="step-pill step-done">Done.</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Comparative Flow Visualization -->
    <div class="friction-grid">
      <!-- The Old Friction -->
      <div class="friction-card before">
        <div class="card-status-badge before-badge">Everyday Friction</div>
        <h3 class="card-title">Juggling windows &amp; dragging across screens</h3>
        <ul class="friction-list">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <line x1="15" y1="9" x2="9" y2="15"/>
              <line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
            <span>5 separate Finder windows covering your desktop</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <line x1="15" y1="9" x2="9" y2="15"/>
              <line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
            <span>Clumsy mouse dragging across multi-monitor setups</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <line x1="15" y1="9" x2="9" y2="15"/>
              <line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
            <span>Accidentally dropping files into the wrong adjacent folder</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <line x1="15" y1="9" x2="9" y2="15"/>
              <line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
            <span>Losing track of which subfolder level you are currently in</span>
          </li>
        </ul>
      </div>

      <!-- The Maggo Way -->
      <div class="friction-card after">
        <div class="card-status-badge after-badge">The Maggo Flow</div>
        <h3 class="card-title">Everything inside one predictable workspace</h3>
        <ul class="friction-list">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>One single window with tabbed folders (⌘T)</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>Instant Move To (⌘⇧M) &amp; Copy To without dragging</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>Dual split view (⌘⇧S) to see source and destination side by side</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span>Clickable breadcrumb path bar for 1-click parent folder jumps</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .problem-section {
    background-color: var(--color-bg-subtle);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .problem-content-block {
    max-width: 800px;
    margin: 0 auto 3.5rem auto;
    text-align: center;
  }

  .lead-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .lead-text {
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--color-text-body);
  }

  .philosophy-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.75rem 2rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    text-align: left;
  }

  .philosophy-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .philosophy-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .philosophy-header {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
  }

  .philosophy-quote {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text-main);
    line-height: 1.5;
  }

  .three-steps {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .step-pill {
    background: #F1F5F9;
    border: 1px solid #CBD5E1;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-body);
  }

  .step-pill.step-done {
    background: #DCFCE7;
    border-color: #86EFAC;
    color: #15803D;
  }

  .step-arrow {
    color: #94A3B8;
    font-weight: bold;
  }

  /* Friction vs Flow Cards */
  .friction-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    max-width: 960px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .friction-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .friction-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
  }

  .friction-card.after {
    border-color: rgba(10, 132, 255, 0.3);
    background: linear-gradient(180deg, #FFFFFF 0%, rgba(10, 132, 255, 0.02) 100%);
    box-shadow: var(--shadow-md);
  }

  .card-status-badge {
    display: inline-block;
    align-self: flex-start;
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .before-badge {
    background: #FEE2E2;
    color: #B91C1C;
  }

  .after-badge {
    background: #DCFCE7;
    color: #15803D;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-main);
    margin-bottom: 1.25rem;
  }

  .friction-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .friction-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text-body);
  }

  .friction-list li svg {
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
</style>
