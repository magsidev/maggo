---
// ComparisonSection.astro
---

<section class="section-wrapper comparison-section" id="comparison-details">
  <div class="container">
    <div class="section-header-center">
      <div class="section-eyebrow">Finder &amp; Maggo</div>
      <h2 class="section-title">
        A calmer, more focused <br class="br-desktop" />alternative to Finder.
      </h2>
      <p class="section-subtitle">
        Finder is fine for general Mac browsing. Maggo is built specifically for people who want faster, more predictable everyday file management.
      </p>
    </div>

    <!-- Comparison Table Container -->
    <div class="table-card">
      <table class="comparison-table">
        <thead>
          <tr>
            <th class="col-feature">Everyday Workflow</th>
            <th class="col-finder">
              <div class="app-header-finder">
                <span class="app-dot finder-dot"></span>
                <span>macOS Finder</span>
              </div>
            </th>
            <th class="col-maggo">
              <div class="app-header-maggo">
                <img src="/images/maggo-logo.png" alt="Maggo Logo" width="20" height="20" style="border-radius: 4px; display: inline-block;" />
                <span>Maggo</span>
                <span class="recommend-badge">Productivity Focus</span>
              </div>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="feature-label">
              <strong>Design Intent</strong>
              <span>Everyday focus</span>
            </td>
            <td class="finder-val">General system browser</td>
            <td class="maggo-val highlight">Dedicated, streamlined file management</td>
          </tr>

          <tr>
            <td class="feature-label">
              <strong>Window Discipline</strong>
              <span>Organizing multiple folders</span>
            </td>
            <td class="finder-val">Scattered, overlapping windows</td>
            <td class="maggo-val highlight">Clean folder tabs in a single window (<span class="kbd-key">⌘T</span>)</td>
          </tr>

          <tr>
            <td class="feature-label">
              <strong>Directory Navigation</strong>
              <span>Understanding folder depth</span>
            </td>
            <td class="finder-val">Standard path bar</td>
            <td class="maggo-val highlight">Clickable interactive breadcrumbs with 1-click jumps</td>
          </tr>

          <tr>
            <td class="feature-label">
              <strong>File Movement</strong>
              <span>Relocating files safely</span>
            </td>
            <td class="finder-val">Manual drag-and-drop across screens</td>
            <td class="maggo-val highlight">Direct Move To (<span class="kbd-key">⌘⇧M</span>) &amp; Copy To dialogs</td>
          </tr>

          <tr>
            <td class="feature-label">
              <strong>Dual-Pane Working</strong>
              <span>Transferring between 2 directories</span>
            </td>
            <td class="finder-val">Single pane only</td>
            <td class="maggo-val highlight">Built-in side-by-side split view (<span class="kbd-key">⌘⇧S</span>)</td>
          </tr>

          <tr>
            <td class="feature-label">
              <strong>Native Mac Heritage</strong>
              <span>System integration</span>
            </td>
            <td class="finder-val">Native macOS component</td>
            <td class="maggo-val highlight">Pure Swift 6 &amp; SwiftUI (Zero Electron bloat)</td>
          </tr>

          <tr>
            <td class="feature-label">
              <strong>Ownership Model</strong>
              <span>Pricing &amp; support</span>
            </td>
            <td class="finder-val">Included with macOS</td>
            <td class="maggo-val highlight price-tag">$19.99 lifetime license (No subscriptions)</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Respectful concluding stance -->
    <div class="stance-block">
      <div class="stance-badge">The Bottom Line</div>
      <p class="stance-quote">
        Maggo doesn't try to reinvent your computer — it simply gives you the disciplined tools to get in, organize your files, and get back to your work.
      </p>
    </div>
  </div>
</section>

<style>
  .comparison-section {
    background-color: #FFFFFF;
  }

  .section-header-center {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 4rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .br-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .br-desktop {
      display: inline;
    }
  }

  .table-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow-x: auto;
    box-shadow: var(--shadow-sm);
    margin-bottom: 3.5rem;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 680px;
  }

  .comparison-table th {
    padding: 1.35rem 1.75rem;
    font-size: 0.875rem;
    font-weight: 700;
    border-bottom: 1px solid var(--color-border);
    background: #F8FAFC;
  }

  .col-feature {
    width: 30%;
    color: var(--color-text-muted);
  }

  .col-finder {
    width: 35%;
  }

  .col-maggo {
    width: 35%;
    background: rgba(136, 84, 208, 0.04) !important;
  }

  .app-header-finder, .app-header-maggo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .app-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .finder-dot { background-color: #94A3B8; }

  .recommend-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    background: #8854D0;
    color: #FFFFFF;
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
    letter-spacing: 0.02em;
  }

  .comparison-table td {
    padding: 1.35rem 1.75rem;
    border-bottom: 1px solid var(--color-border-subtle);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .feature-label {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .feature-label strong {
    color: var(--color-text-main);
    font-size: 0.95rem;
  }

  .feature-label span {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .finder-val {
    color: var(--color-text-muted);
  }

  .maggo-val {
    color: var(--color-text-main);
    font-weight: 500;
  }

  .maggo-val.highlight {
    background: rgba(136, 84, 208, 0.02);
    color: var(--color-text-main);
    font-weight: 600;
  }

  .price-tag {
    color: var(--color-accent);
    font-weight: 700;
  }

  .stance-block {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2.5rem;
  }

  .stance-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: #E2E8F0;
    color: #475569;
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    margin-bottom: 0.85rem;
  }

  .stance-quote {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-text-main);
    font-weight: 500;
  }
</style>
