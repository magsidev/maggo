---
// FeatureMarquee.astro
const tools = [
  { name: "Dual Split View", kbd: "⌘⇧S" },
  { name: "Folder Tabs", kbd: "⌘T" },
  { name: "Move To…", kbd: "⌘⇧M" },
  { name: "Clickable Breadcrumbs", kbd: "1-Click" },
  { name: "Drive Capacity Gauge", kbd: "Live" },
  { name: "Smart Pictures Gallery", kbd: "Filter" },
  { name: "Fast Search", kbd: "Instant" },
  { name: "Copy Path", kbd: "⌘⌥C" },
  { name: "100% Offline & Private", kbd: "Local" },
  { name: "Native Swift 6", kbd: "15ms" },
  { name: "Quick Look", kbd: "Space" },
  { name: "Safe Undo", kbd: "⌘Z" }
];
---

<div class="marquee-strip-wrapper">
  <div class="marquee-fade-left"></div>
  <div class="marquee-fade-right"></div>
  
  <div class="animate-marquee">
    {tools.concat(tools).map((tool) => (
      <div class="marquee-chip">
        <span class="chip-name">{tool.name}</span>
        <span class="chip-kbd">{tool.kbd}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .marquee-strip-wrapper {
    position: relative;
    overflow: hidden;
    background: var(--color-bg-warm);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 1.15rem 0;
  }

  .marquee-fade-left, .marquee-fade-right {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100px;
    z-index: 2;
    pointer-events: none;
  }

  .marquee-fade-left {
    left: 0;
    background: linear-gradient(90deg, var(--color-bg-warm) 0%, transparent 100%);
  }

  .marquee-fade-right {
    right: 0;
    background: linear-gradient(270deg, var(--color-bg-warm) 0%, transparent 100%);
  }

  .marquee-chip {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: #FFFFFF;
    border: 1px solid var(--color-border-strong);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    margin-right: 0.85rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    white-space: nowrap;
  }

  .chip-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-main);
  }

  .chip-kbd {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    background: var(--color-bg-warm);
    color: var(--color-accent);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(136, 84, 208, 0.2);
  }
</style>
