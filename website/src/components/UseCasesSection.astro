---
// UseCasesSection.astro
---

<section class="section-wrapper usecases-section" id="use-cases">
  <div class="container">
    <div class="section-header-center">
      <div class="section-eyebrow">Real Everyday Workflows</div>
      <h2 class="section-title">
        Built for the moments that <br class="br-desktop" />slow you down.
      </h2>
      <p class="section-subtitle">
        Maggo is designed for tangible daily friction points, without forcing you to re-architect how you work on macOS.
      </p>
    </div>

    <div class="usecases-grid">
      <!-- Use Case 1 -->
      <div class="usecase-card">
        <div class="usecase-icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
          </svg>
        </div>
        <h3 class="usecase-audience">Clearing a crowded Downloads folder</h3>
        <div class="usecase-flow">
          <span class="flow-action">Download asset</span>
          <span class="flow-arrow">&darr;</span>
          <span class="flow-action highlight">Move directly to project archive (⌘⇧M)</span>
          <span class="flow-arrow">&darr;</span>
          <span class="flow-action">Desktop stays clean</span>
        </div>
        <p class="usecase-description">
          Never let your Downloads folder become a permanent graveyard. Select downloaded files and instantly file them away with fuzzy search.
        </p>
      </div>

      <!-- Use Case 2 -->
      <div class="usecase-card">
        <div class="usecase-icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
          </svg>
        </div>
        <h3 class="usecase-audience">Working across multiple project workspaces</h3>
        <div class="usecase-flow single-line">
          <span>Keep active client repos, design assets, and invoices organized in tabs (⌘T).</span>
        </div>
        <p class="usecase-description">
          Instead of scattering 8 Finder windows across virtual desktops, keep all active directory contexts neatly contained inside one window.
        </p>
      </div>

      <!-- Use Case 3 -->
      <div class="usecase-card">
        <div class="usecase-icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
        </div>
        <h3 class="usecase-audience">High-frequency file sorting &amp; transfers</h3>
        <div class="usecase-flow single-line">
          <span>Move To • Copy To • Split View • Keyboard Shortcuts</span>
        </div>
        <p class="usecase-description">
          Zero mouse fatigue. Select with arrow keys, press <span class="kbd-key">⌘⇧M</span> to relocate items, or open Split View (<span class="kbd-key">⌘⇧S</span>) for 100% drag precision.
        </p>
      </div>

      <!-- Use Case 4 -->
      <div class="usecase-card">
        <div class="usecase-icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="4" y="4" width="16" height="16" rx="2"/>
            <rect x="9" y="9" width="6" height="6"/>
            <line x1="9" y1="1" x2="9" y2="4"/>
            <line x1="15" y1="1" x2="15" y2="4"/>
            <line x1="9" y1="20" x2="9" y2="23"/>
            <line x1="15" y1="20" x2="15" y2="23"/>
            <line x1="20" y1="9" x2="23" y2="9"/>
            <line x1="20" y1="14" x2="23" y2="14"/>
            <line x1="1" y1="9" x2="4" y2="9"/>
            <line x1="1" y1="14" x2="4" y2="14"/>
          </svg>
        </div>
        <h3 class="usecase-audience">Managing external SSDs &amp; backups</h3>
        <div class="usecase-flow single-line">
          <span>Navigate internal storage and external volumes seamlessly side by side.</span>
        </div>
        <p class="usecase-description">
          Connected SSDs and flash drives appear immediately in the sidebar with live storage gauges and one-click eject controls.
        </p>
      </div>

      <!-- Use Case 5 (Wide) -->
      <div class="usecase-card usecase-wide">
        <div class="usecase-icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <circle cx="12" cy="12" r="6"/>
            <circle cx="12" cy="12" r="2"/>
          </svg>
        </div>
        <div class="usecase-wide-content">
          <h3 class="usecase-audience">For anyone who wants a more disciplined Mac workspace</h3>
          <p class="usecase-quote">
            “You don't need a complicated reason. Sometimes you just want a file manager that stays out of your way.”
          </p>
          <p class="usecase-description">
            Finder was built for general desktop computing. Maggo is purpose-built for creators, engineers, and power users who value intentional speed.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .usecases-section {
    background-color: var(--color-bg-subtle);
    border-top: 1px solid var(--color-border-light);
    border-bottom: 1px solid var(--color-border-light);
  }

  .section-header-center {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 4rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .br-desktop {
    display: none;
  }

  @media (min-width: 768px) {
    .br-desktop {
      display: inline;
    }
  }

  .usecases-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .usecases-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .usecase-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-xl);
    padding: 2.5rem 2.25rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s var(--ease-apple), box-shadow 0.2s var(--ease-apple);
  }

  .usecase-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .usecase-wide {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 2rem;
  }

  @media (max-width: 640px) {
    .usecase-wide {
      flex-direction: column;
      gap: 1.25rem;
    }
  }

  .usecase-icon-box {
    width: 44px;
    height: 44px;
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    border: 1px solid var(--color-accent-border);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    flex-shrink: 0;
  }

  .usecase-wide .usecase-icon-box {
    margin-bottom: 0;
  }

  .usecase-wide-content {
    flex: 1;
  }

  .usecase-audience {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-main);
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .usecase-flow {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    padding: 0.85rem 1.15rem;
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-body);
    margin-bottom: 1.25rem;
  }

  .usecase-flow.single-line {
    flex-direction: row;
    align-items: center;
    color: var(--color-accent);
  }

  .flow-action.highlight {
    color: var(--color-accent);
  }

  .flow-arrow {
    color: #94A3B8;
    font-size: 0.75rem;
  }

  .usecase-quote {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: 0.85rem;
    line-height: 1.5;
    letter-spacing: -0.015em;
  }

  .usecase-description {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
</style>
